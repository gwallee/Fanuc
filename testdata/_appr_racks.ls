/PROG  _APPR_RACKS
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Appr Rack 1-6";
PROG_SIZE	= 4483;
CREATE		= DATE 26-06-26  TIME 10:14:56;
MODIFIED	= DATE 26-08-24  TIME 14:55:10;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 234;
MEMORY_SIZE	= 5103;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  !******APPR RACKS FOR PKPL******* ;
   2:  !AR1: 0=Rack PKPL, 7=Appr Reject ;
   3:  LBL[100] ;
   4:  F[700:OFF:Appr Error]=(OFF) ;
   5:  R[396:*AR1]=AR[1]    ;
   6:   ;
   7:  IF (F[1:ON :Part in Grip]) THEN ;
   8:  R[113:*ApprSpd-L]=R[103:ToteSpd-L]    ;
   9:  R[114:*ApprSpd-J]=R[104:ToteSpd-J]    ;
  10:  ELSE ;
  11:  R[113:*ApprSpd-L]=R[101:EmptySpd-L]    ;
  12:  R[114:*ApprSpd-J]=R[102:EmptySpd-J]    ;
  13:  ENDIF ;
  14:   ;
  15:  !**Jump for Robot Pos ;
  16:  UFRAME_NUM=0 ;
  17:  UTOOL_NUM=1 ;
  18:  IF (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr]),JMP LBL[600] ;
  19:  IF (DO[201:OFF:At Conv1/3 Appr] OR DO[202:OFF:At Recon Appr]),JMP LBL[200] ;
  20:  IF (DO[205:OFF:At Hopper Appr]),JMP LBL[300] ;
  21:  IF (DO[37:OFF:At Transit]),JMP LBL[500] ;
  22:   ;
  23:  CALL _RECOVER    ;
  24:  JMP LBL[100] ;
  25:   ;
  26:   ;
  27:  !**********At Conveyors********** ;
  28:  LBL[200] ;
  29:  IF R[396:*AR1]=7,JMP LBL[220] ;
  30:  IF (R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2),JMP LBL[210] ;
  31:  IF (R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4),JMP LBL[220] ;
  32:  JMP LBL[700] ;
  33:   ;
  34:  !***Appr-Left Side Slots********* ;
  35:  LBL[210] ;
  36:  IF (DO[201:OFF:At Conv1/3 Appr]),JMP LBL[215] ;
  37:  IF (!DO[202:OFF:At Recon Appr]),JMP LBL[100] ;
  38:  !**At ReconAppr, go to Rack ;
  39:J PR[117:Appr-ReconConvs] R[114:*ApprSpd-J]% CNT100    ;
  40:L PR[135:Appr-Rack3-Left] R[113:*ApprSpd-L]mm/sec CNT100    ;
  41:  WAIT (DO[211:ON :At L-RacksApr])    ;
  42:  JMP LBL[900] ;
  43:  !**At In/Out1 Appr, go to Transit ;
  44:  LBL[215] ;
  45:J PR[116:Appr-InfdOutfd-1] R[114:*ApprSpd-J]% CNT100    ;
  46:  CALL _SET_OFFS(0,0,325,60) ;
  47:L PR[116:Appr-InfdOutfd-1] R[113:*ApprSpd-L]mm/sec CNT100 Offset    ;
  48:  CALL _TRANSIT((-93)) ;
  49:  WAIT (DO[37:OFF:At Transit])    ;
  50:  JMP LBL[100] ;
  51:   ;
  52:  !***Appr-Right Side Slots******** ;
  53:  LBL[220] ;
  54:  IF (DO[202:OFF:At Recon Appr]),JMP LBL[225] ;
  55:  IF (!DO[201:OFF:At Conv1/3 Appr]),JMP LBL[100] ;
  56:  !**At In/Out1 Appr, go to Rack ;
  57:J PR[116:Appr-InfdOutfd-1] R[114:*ApprSpd-J]% CNT100    ;
  58:L PR[136:Appr-Rack3-Right] R[113:*ApprSpd-L]mm/sec CNT100    ;
  59:  WAIT (DO[212:OFF:At R-RacksApr])    ;
  60:  JMP LBL[900] ;
  61:  !**At Recon Appr, go to Transit ;
  62:  LBL[225] ;
  63:J PR[117:Appr-ReconConvs] R[114:*ApprSpd-J]% CNT100    ;
  64:  CALL _SET_OFFS(0,0,325,60) ;
  65:L PR[117:Appr-ReconConvs] R[113:*ApprSpd-L]mm/sec CNT100 Offset    ;
  66:  CALL _TRANSIT((-27)) ;
  67:  WAIT (DO[37:OFF:At Transit])    ;
  68:  JMP LBL[100] ;
  69:   ;
  70:   ;
  71:  !***At Hopper Appr*************** ;
  72:  LBL[300] ;
  73:  IF R[396:*AR1]=7,JMP LBL[320] ;
  74:  IF (R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2),JMP LBL[310] ;
  75:  IF (R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4),JMP LBL[320] ;
  76:  JMP LBL[700] ;
  77:   ;
  78:  !***Appr-Left Side Slots*** ;
  79:  LBL[310] ;
  80:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  81:J PR[137:Appr-Rack4-Left] R[114:*ApprSpd-J]% CNT100    ;
  82:  WAIT (DO[211:ON :At L-RacksApr])    ;
  83:  JMP LBL[900] ;
  84:   ;
  85:  !***Appr-Right Side Slots*** ;
  86:  LBL[320] ;
  87:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  88:J PR[138:Appr-Rack4-Right] R[114:*ApprSpd-J]% CNT100    ;
  89:  WAIT (DO[212:OFF:At R-RacksApr])    ;
  90:  JMP LBL[900] ;
  91:   ;
  92:   ;
  93:  !********Transit to Rack********* ;
  94:  LBL[500] ;
  95:  IF R[396:*AR1]=7,JMP LBL[570] ;
  96:  SELECT R[20:*RackNum]=1,JMP LBL[510] ;
  97:         =2,JMP LBL[520] ;
  98:         =3,JMP LBL[530] ;
  99:         =4,JMP LBL[540] ;
 100:         =5,JMP LBL[550] ;
 101:         =6,JMP LBL[560] ;
 102:  JMP LBL[700] ;
 103:   ;
 104:  !***Appr Rack1*** ;
 105:  LBL[510] ;
 106:  IF (R[25:*Slot-Colmn]<=2) THEN ;
 107:  !Appr Rack-Left ;
 108:  R[91:*tempX]=(-155)    ;
 109:  PR[91:*temp1]=PR[131:Appr-Rack1-Left]    ;
 110:  ELSE ;
 111:  !Appr Rack-Right ;
 112:  R[91:*tempX]=155    ;
 113:  PR[91:*temp1]=PR[132:Appr-Rack1-Right]    ;
 114:  ENDIF ;
 115:  JMP LBL[590] ;
 116:   ;
 117:  !***Appr Rack2*** ;
 118:  LBL[520] ;
 119:  IF (R[25:*Slot-Colmn]<=2) THEN ;
 120:  !Appr Rack-Left ;
 121:  R[91:*tempX]=(-95)    ;
 122:  PR[91:*temp1]=PR[133:Appr-Rack2-Left]    ;
 123:  ELSE ;
 124:  !Appr Rack-Right ;
 125:  R[91:*tempX]=(-145)    ;
 126:  PR[91:*temp1]=PR[134:Appr-Rack2-Right]    ;
 127:  ENDIF ;
 128:  JMP LBL[590] ;
 129:   ;
 130:  !***Appr Rack3*** ;
 131:  LBL[530] ;
 132:  IF (R[25:*Slot-Colmn]<=2) THEN ;
 133:  !Appr Rack-Left ;
 134:  R[91:*tempX]=(-35)    ;
 135:  PR[91:*temp1]=PR[135:Appr-Rack3-Left]    ;
 136:  ELSE ;
 137:  !Appr Rack-Right ;
 138:  R[91:*tempX]=(-85)    ;
 139:  PR[91:*temp1]=PR[136:Appr-Rack3-Right]    ;
 140:  ENDIF ;
 141:  JMP LBL[590] ;
 142:   ;
 143:  !***Appr Rack4*** ;
 144:  LBL[540] ;
 145:  IF (R[25:*Slot-Colmn]<=2) THEN ;
 146:  !Appr Rack-Left ;
 147:  R[91:*tempX]=25    ;
 148:  PR[91:*temp1]=PR[137:Appr-Rack4-Left]    ;
 149:  ELSE ;
 150:  !Appr Rack-Right ;
 151:  R[91:*tempX]=(-25)    ;
 152:  PR[91:*temp1]=PR[138:Appr-Rack4-Right]    ;
 153:  ENDIF ;
 154:  JMP LBL[590] ;
 155:   ;
 156:  !***Appr Rack5*** ;
 157:  LBL[550] ;
 158:  IF (R[25:*Slot-Colmn]<=2) THEN ;
 159:  !Appr Rack-Left ;
 160:  R[91:*tempX]=85    ;
 161:  PR[91:*temp1]=PR[139:Appr-Rack5-Left]    ;
 162:  ELSE ;
 163:  !Appr Rack-Right ;
 164:  R[91:*tempX]=35    ;
 165:  PR[91:*temp1]=PR[140:Appr-Rack5-Right]    ;
 166:  ENDIF ;
 167:  JMP LBL[590] ;
 168:   ;
 169:  !***Appr Rack6*** ;
 170:  LBL[560] ;
 171:  IF (R[25:*Slot-Colmn]<=2) THEN ;
 172:  !Appr Rack-Left ;
 173:  R[91:*tempX]=145    ;
 174:  PR[91:*temp1]=PR[141:Appr-Rack6-Left]    ;
 175:  ELSE ;
 176:  !Appr Rack-Right ;
 177:  R[91:*tempX]=95    ;
 178:  PR[91:*temp1]=PR[142:Appr-Rack6-Right]    ;
 179:  ENDIF ;
 180:  JMP LBL[590] ;
 181:   ;
 182:  !***Appr Reject*** ;
 183:  LBL[570] ;
 184:  R[91:*tempX]=155    ;
 185:  PR[91:*temp1]=PR[132:Appr-Rack1-Right]    ;
 186:  JMP LBL[590] ;
 187:   ;
 188:  !***Transit to Rack*** ;
 189:  LBL[590] ;
 190:  CALL _TRANSIT(R[91:*tempX]) ;
 191:J PR[91:*temp1] R[104:ToteSpd-J]% CNT100 ACC50    ;
 192:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
 193:  JMP LBL[900] ;
 194:   ;
 195:   ;
 196:  !**********At Racks Appr********* ;
 197:  LBL[600] ;
 198:  IF R[396:*AR1]=7,JMP LBL[620] ;
 199:  IF (R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2),JMP LBL[610] ;
 200:  IF (R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4),JMP LBL[620] ;
 201:  JMP LBL[700] ;
 202:   ;
 203:  !***Appr-Left Side Slots*** ;
 204:  LBL[610] ;
 205:  IF (DO[211:ON :At L-RacksApr]),JMP LBL[900] ;
 206:  JMP LBL[650] ;
 207:   ;
 208:  !***Appr-Right Side Slots*** ;
 209:  LBL[620] ;
 210:  IF (DO[212:OFF:At R-RacksApr]),JMP LBL[900] ;
 211:  JMP LBL[650] ;
 212:   ;
 213:  !***Return to Transit*** ;
 214:  LBL[650] ;
 215:  PR[100:*JPOS]=JPOS    ;
 216:  R[99:*temp]=PR[100,1:*JPOS]    ;
 217:  CALL _TRANSIT(R[99:*temp]) ;
 218:  WAIT (DO[37:OFF:At Transit])    ;
 219:  JMP LBL[100] ;
 220:   ;
 221:   ;
 222:  !***Appr Error******************* ;
 223:  LBL[700] ;
 224:  F[700:OFF:Appr Error]=(ON) ;
 225:  JMP LBL[999] ;
 226:   ;
 227:   ;
 228:  !***Appr Done******************** ;
 229:  LBL[900] ;
 230:  F[700:OFF:Appr Error]=(OFF) ;
 231:  JMP LBL[999] ;
 232:   ;
 233:   ;
 234:  LBL[999] ;
/POS
/END
