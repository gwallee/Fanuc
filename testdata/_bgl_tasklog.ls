/PROG  _BGL_TASKLOG
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "BGL Lane Data";
PROG_SIZE	= 387;
CREATE		= DATE 26-05-28  TIME 15:37:14;
MODIFIED	= DATE 26-07-13  TIME 11:10:58;
FILE_NAME	= _BGL_LAN;
VERSION		= 0;
LINE_COUNT	= 8;
MEMORY_SIZE	= 727;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : FALSE;
/MN
   1:  !*****SAVE PREVIOUS TASK IDS***** ;
   2:  !***BGL-Task Log Running Chk*** ;
   3:  IF (F[1010:OFF:BGL Chk-Running]) THEN ;
   4:  IF (F[1012:OFF:BGL-TaskLog Chk]),F[1015:OFF:BGL-TaskLog Ack]=(ON) ;
   5:  ELSE ;
   6:  F[1015:OFF:BGL-TaskLog Ack]=(OFF) ;
   7:  ENDIF ;
   8:   ;
/POS
/END
