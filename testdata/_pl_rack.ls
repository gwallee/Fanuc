/PROG  _PL_RACK
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "PL in BufferRack";
PROG_SIZE	= 3045;
CREATE		= DATE 26-07-24  TIME 23:00:50;
MODIFIED	= DATE 26-08-25  TIME 11:24:08;
FILE_NAME	= _BOX_PK;
VERSION		= 0;
LINE_COUNT	= 150;
MEMORY_SIZE	= 3493;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : FALSE;
/MN
   1:  !*******PLACE TOTE IN RACK******* ;
   2:  LBL[100] ;
   3:  IF (!F[1:ON :Part in Grip]),JMP LBL[999] ;
   4:   ;
   5:   ;
   6:  !***Set Rack PL Pos************** ;
   7:  LBL[150] ;
   8:  F[20:OFF:Rack PKPL-Set]=(OFF) ;
   9:  CALL _SET_RACK_PL    ;
  10:  IF (F[20:OFF:Rack PKPL-Set]),JMP LBL[200] ;
  11:  JMP LBL[999] ;
  12:   ;
  13:   ;
  14:  !***Appr Rack******************** ;
  15:  LBL[200] ;
  16:  IF (DO[204:OFF:At Inspct Pos]),JMP LBL[205] ;
  17:  !Normal Rack Appr ;
  18:  CALL _APPR_RACKS(0) ;
  19:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  20:  IF ((R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2) AND DO[211:ON :At L-RacksApr]),JMP LBL[300] ;
  21:  IF ((R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4) AND DO[212:OFF:At R-RacksApr]),JMP LBL[300] ;
  22:  JMP LBL[200] ;
  23:   ;
  24:  !***Appr From Inspect************ ;
  25:  LBL[205] ;
  26:  IF (!DO[204:OFF:At Inspct Pos]),JMP LBL[200] ;
  27:  UFRAME_NUM=0 ;
  28:  UTOOL_NUM=1 ;
  29:   ;
  30:  CALL _SET_OFFS(0,0,(-8),61) ;
  31:L PR[45:Inspect Pos] R[107:Rtrt Spd]mm/sec CNT50 Tool_Offset    ;
  32:  CALL _SET_OFFS((-600),0,(-8),61) ;
  33:L PR[45:Inspect Pos] R[103:ToteSpd-L]mm/sec CNT100 Tool_Offset    ;
  34:  CALL _SET_OFFS((-1000),0,(-8),61) ;
  35:L PR[45:Inspect Pos] R[103:ToteSpd-L]mm/sec CNT100 Tool_Offset    ;
  36:  !**Jump for Rack to PL ;
  37:  SELECT R[25:*Slot-Colmn]=1,JMP LBL[210] ;
  38:         =2,JMP LBL[210] ;
  39:         =3,JMP LBL[220] ;
  40:         =4,JMP LBL[220] ;
  41:   ;
  42:  !***Go to Hopper Appr*** ;
  43:L PR[41:Hopper Appr] R[103:ToteSpd-L]mm/sec CNT100    ;
  44:  WAIT (DO[205:OFF:At Hopper Appr])    ;
  45:  JMP LBL[200] ;
  46:   ;
  47:  !***Appr Rack-Left Side*** ;
  48:  LBL[210] ;
  49:L PR[137:Appr-Rack4-Left] R[103:ToteSpd-L]mm/sec CNT100 Wjnt    ;
  50:  JMP LBL[300] ;
  51:   ;
  52:  !***Appr Rack-Right Side*** ;
  53:  LBL[220] ;
  54:L PR[138:Appr-Rack4-Right] R[103:ToteSpd-L]mm/sec CNT100 Wjnt    ;
  55:  JMP LBL[300] ;
  56:   ;
  57:   ;
  58:  !***Move into Rack*************** ;
  59:  LBL[300] ;
  60:  UFRAME_NUM=R[20:*RackNum] ;
  61:  UTOOL_NUM=1 ;
  62:   ;
  63:J PR[21:*Rack Appr] R[104:ToteSpd-J]% CNT50    ;
  64:   ;
  65:  !***Appr Rack Slot*** ;
  66:  LBL[310] ;
  67:  CALL _SET_OFFS(0,(-675),15,60) ;
  68:L PR[20:*Rack PKPL] R[103:ToteSpd-L]mm/sec CNT25 Offset    ;
  69:   ;
  70:  !**Relax Clamp to Settle Tote ;
  71:  DO[65:OFF:Ext Clamp-Up]=OFF ;
  72:  DO[66:OFF:Ret Clamp-Down]=ON ;
  73:  DO[67:OFF:Ext Hook-Closed]=OFF ;
  74:   ;
  75:  CALL _SET_OFFS(0,(-625),12,60) ;
  76:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec CNT50 Offset    ;
  77:   ;
  78:  !**Relax Clamp, Re-Hook Tote ;
  79:  DO[66:OFF:Ret Clamp-Down]=OFF ;
  80:  DO[68:OFF:Ret Hook-Open]=OFF ;
  81:  DO[67:OFF:Ext Hook-Closed]=ON ;
  82:   ;
  83:  CALL _SET_OFFS(0,(-600),10,60) ;
  84:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec CNT50 Offset    ;
  85:   ;
  86:  !**Re-Clamp ;
  87:  DO[66:OFF:Ret Clamp-Down]=ON ;
  88:   ;
  89:  CALL _SET_OFFS(0,(-50),5,60) ;
  90:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec CNT100 Offset    ;
  91:   ;
  92:  !**Relax Clamp/Hook ;
  93:  DO[66:OFF:Ret Clamp-Down]=OFF ;
  94:  DO[67:OFF:Ext Hook-Closed]=OFF ;
  95:   ;
  96:  !**Move to PL Pos ;
  97:  LBL[350] ;
  98:  CALL _SET_OFFS(0,0,1,60) ;
  99:L PR[20:*Rack PKPL] R[106:PL Spd]mm/sec FINE Offset    ;
 100:  DO[66:OFF:Ret Clamp-Down]=ON ;
 101:  DO[67:OFF:Ext Hook-Closed]=ON ;
 102:  JMP LBL[400] ;
 103:   ;
 104:   ;
 105:  !***Drop Tote******************** ;
 106:  LBL[400] ;
 107:  !**Update Rack Slot Status ;
 108:  R[199:*RackSts-Reg]=R[21:*SlotNum]+200    ;
 109:  R[R[199]]=1    ;
 110:   ;
 111:  !**Rack PL hs ;
 112:  DO[22:OFF:Rack Placed]=ON ;
 113:  WAIT (!DI[22:OFF:RackPL Rdy])    ;
 114:  DO[22:OFF:Rack Placed]=OFF ;
 115:   ;
 116:  !***Open Grip*** ;
 117:  CALL _GRIP_PL    ;
 118:  R[5:*Grp-ToteID]=0    ;
 119:  R[100:*Tote-Sts ID]=0    ;
 120:  JMP LBL[500] ;
 121:   ;
 122:   ;
 123:  !***Retreat Rack***************** ;
 124:  LBL[500] ;
 125:  CALL _SET_OFFS(0,0,(-15),60) ;
 126:L PR[20:*Rack PKPL] R[106:PL Spd]mm/sec CNT25 Offset    ;
 127:  CALL _SET_OFFS(0,(-125),(-15),60) ;
 128:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec CNT100 Offset    ;
 129:  CALL _SET_OFFS(0,(-475),(-15),60) ;
 130:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
 131:   ;
 132:   ;
 133:  !**Return to Rack Appr ;
 134:L PR[21:*Rack Appr] R[101:EmptySpd-L]mm/sec CNT75    ;
 135:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
 136:  JMP LBL[600] ;
 137:   ;
 138:   ;
 139:  !***Place Done******************* ;
 140:  LBL[600] ;
 141:  R[17:*PrevPL-Rack]=R[20:*RackNum]    ;
 142:  R[18:*PrevPL-Colmn]=R[25:*Slot-Colmn]    ;
 143:  R[19:*PrevPL-Row]=R[26:*Slot-Row]    ;
 144:  R[20:*RackNum]=0    ;
 145:  R[25:*Slot-Colmn]=0    ;
 146:  R[26:*Slot-Row]=0    ;
 147:  JMP LBL[999] ;
 148:   ;
 149:   ;
 150:  LBL[999] ;
/POS
/END
