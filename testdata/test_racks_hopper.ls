/PROG  TEST_RACKS_HOPPER
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 5285;
CREATE		= DATE 26-07-16  TIME 14:47:56;
MODIFIED	= DATE 26-07-17  TIME 04:40:30;
FILE_NAME	= TEST_RAC;
VERSION		= 0;
LINE_COUNT	= 252;
MEMORY_SIZE	= 5881;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  //R[20:*RackNum]=1    ;
   2:  //R[11:Tst-SlotInRack]=1    ;
   3:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
   4:   ;
   5:  !***Set Bin PKPL Pos************* ;
   6:  LBL[100] ;
   7:  CALL SET_RACK_TEST    ;
   8:  IF (!F[20:OFF:Rack PKPL-Set]),JMP LBL[7000] ;
   9:   ;
  10:   ;
  11:  !*********PICK FROM RACK********* ;
  12:  LBL[200] ;
  13:  IF (F[1001:OFF:Tst-Cont Rack]),JMP LBL[215] ;
  14:  CALL _APPR_RACKS(0) ;
  15:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  16:   ;
  17:  IF ((R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2) AND DO[211:ON :At L-RacksApr]),JMP LBL[210] ;
  18:  IF ((R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4) AND DO[212:OFF:At R-RacksApr]),JMP LBL[210] ;
  19:  JMP LBL[200] ;
  20:   ;
  21:  !***Move into Rack*************** ;
  22:  LBL[210] ;
  23:  UFRAME_NUM=R[20:*RackNum] ;
  24:  UTOOL_NUM=1 ;
  25:J PR[21:*Rack Appr] R[102:EmptySpd-J]% CNT50    ;
  26:   ;
  27:  LBL[215] ;
  28:  UFRAME_NUM=R[20:*RackNum] ;
  29:  UTOOL_NUM=1 ;
  30:  CALL _SET_OFFS(0,(-475),(-15),60) ;
  31:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
  32:  CALL _GRIP_OPEN    ;
  33:   ;
  34:  CALL _SET_OFFS(0,(-250),(-15),60) ;
  35:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
  36:  CALL _SET_OFFS(0,0,(-15),60) ;
  37:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec FINE Offset    ;
  38:   ;
  39:  !**Move to PK Pos ;
  40:  CALL _SET_OFFS(0,0,3,60) ;
  41:L PR[20:*Rack PKPL] R[105:Pk Spd]mm/sec FINE Offset    ;
  42:   ;
  43:  !***Grip Tote******************** ;
  44:  LBL[220] ;
  45:  CALL _GRIP_PK    ;
  46:  R[5:*Grp-ToteID]=R[21:*SlotNum]    ;
  47:  !**Update Rack Slot Status ;
  48:  R[199:*RackSts-Reg]=R[21:*SlotNum]+200    ;
  49:  R[R[199]]=0    ;
  50:  JMP LBL[250] ;
  51:   ;
  52:  !***Retreat Rack***************** ;
  53:  LBL[250] ;
  54:  CALL _SET_OFFS(0,0,10,60) ;
  55:L PR[20:*Rack PKPL] R[105:Pk Spd]mm/sec CNT25 Offset    ;
  56:  CALL _SET_OFFS(0,(-675),10,60) ;
  57:L PR[20:*Rack PKPL] R[111:RackPkSpd]mm/sec CNT50 Offset    ;
  58:   ;
  59:  !**Return to Rack Appr ;
  60:L PR[21:*Rack Appr] R[103:ToteSpd-L]mm/sec CNT75    ;
  61:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
  62:  JMP LBL[300] ;
  63:   ;
  64:   ;
  65:  !******************************** ;
  66:  !***Move into Hopper************* ;
  67:  LBL[300] ;
  68:  PR[40:*Hopper Pos]=PR[43:Orig-Hopper-Nrml]    ;
  69:   ;
  70:  IF (DO[205:OFF:At Hopper Appr]),JMP LBL[310] ;
  71:  CALL _APPR_HOPPER(1) ;
  72:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  73:  JMP LBL[300] ;
  74:   ;
  75:  !***Move into Hopper************* ;
  76:  LBL[310] ;
  77:  UFRAME_NUM=0 ;
  78:  UTOOL_NUM=1 ;
  79:J PR[41:Hopper Appr] R[104:ToteSpd-J]% CNT100    ;
  80:   ;
  81:  CALL _SET_OFFS((-800),0,(-8),61) ;
  82:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT50 Tool_Offset    ;
  83:   ;
  84:  CALL _SET_OFFS((-600),0,(-8),61) ;
  85:L PR[40:*Hopper Pos] R[103:ToteSpd-L]mm/sec CNT100 Tool_Offset    ;
  86:  CALL _SET_OFFS(0,0,(-8),61) ;
  87:L PR[40:*Hopper Pos] R[103:ToteSpd-L]mm/sec CNT25 Tool_Offset    ;
  88:   ;
  89:  !**Move to Dump Pos ;
  90:L PR[40:*Hopper Pos] R[106:PL Spd]mm/sec FINE    ;
  91:  WAIT (DO[206:OFF:At Dump Pos] OR DO[207:OFF:At Dump-Divide Pos])    ;
  92:   ;
  93:  !***Fill Tote******************** ;
  94:  LBL[320] ;
  95:  //IF (!DO[206:OFF:At Dump Pos] AND !DO[207:OFF:At Dump-Divide Pos]),JMP LBL[300] ;
  96:  //DO[23:OFF:Tote in Pos]=OFF ;
  97:  //DO[24:OFF:Dump Dn Ack]=OFF ;
  98:  //WAIT (DI[23:OFF:Hopper Rdy] AND !DI[24:OFF:Hopper Done])    ;
  99:  //!**Trigger Dump ;
 100:  //CALL _SET_WAIT(R[42:*WaitTm x100]) ;
 101:  //DO[23:OFF:Tote in Pos]=ON ;
 102:  //!Wait for Pass/Fail ;
 103:  //WAIT (DI[24:OFF:Hopper Done]) TIMEOUT,LBL[327] ;
 104:  //JMP LBL[330] ;
 105:  //!**Dump Not Done ;
 106:  //LBL[*327] ;
 107:  //DO[23:OFF:Tote in Pos]=OFF ;
 108:  //DO[56:OFF:Hopper Err]=ON ;
 109:  //PAUSE ;
 110:  //DO[56:OFF:Hopper Err]=OFF ;
 111:  //JMP LBL[320] ;
 112:  //!***Dump Finished*** ;
 113:  //LBL[*330] ;
 114:  //R[100:*Tote-Sts ID]=40    ;
 115:  //DO[23:OFF:Tote in Pos]=OFF ;
 116:  //JMP LBL[350] ;
 117:  WAIT   1.00(sec) ;
 118:   ;
 119:   ;
 120:  !***Retreat Hopper*************** ;
 121:  LBL[350] ;
 122:  CALL _SET_OFFS(0,0,(-8),61) ;
 123:L PR[40:*Hopper Pos] R[107:Rtrt Spd]mm/sec CNT50 Tool_Offset    ;
 124:  CALL _SET_OFFS((-600),0,(-8),61) ;
 125:L PR[40:*Hopper Pos] R[103:ToteSpd-L]mm/sec CNT100 Tool_Offset    ;
 126:   ;
 127:  !***Go to Appr Pos*** ;
 128:  CALL _SET_OFFS((-800),0,(-8),61) ;
 129:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT50 Tool_Offset    ;
 130:   ;
 131:L PR[41:Hopper Appr] R[103:ToteSpd-L]mm/sec CNT100    ;
 132:  WAIT (DO[205:OFF:At Hopper Appr])    ;
 133:  JMP LBL[400] ;
 134:  !******************************** ;
 135:   ;
 136:   ;
 137:  !*********PLACE IN RACK********* ;
 138:  LBL[400] ;
 139:  CALL _APPR_RACKS(0) ;
 140:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
 141:   ;
 142:  IF ((R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2) AND DO[211:ON :At L-RacksApr]),JMP LBL[410] ;
 143:  IF ((R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4) AND DO[212:OFF:At R-RacksApr]),JMP LBL[410] ;
 144:  JMP LBL[400] ;
 145:   ;
 146:  !***Move into Rack*************** ;
 147:  LBL[410] ;
 148:  UFRAME_NUM=R[20:*RackNum] ;
 149:  UTOOL_NUM=1 ;
 150:J PR[21:*Rack Appr] R[104:ToteSpd-J]% CNT50    ;
 151:   ;
 152:  LBL[415] ;
 153:  UFRAME_NUM=R[20:*RackNum] ;
 154:  UTOOL_NUM=1 ;
 155:  CALL _SET_OFFS(0,(-675),15,60) ;
 156:L PR[20:*Rack PKPL] R[103:ToteSpd-L]mm/sec CNT50 Offset    ;
 157:  CALL _SET_OFFS(0,(-600),10,60) ;
 158:L PR[20:*Rack PKPL] R[103:ToteSpd-L]mm/sec CNT50 Offset    ;
 159:  CALL _SET_OFFS(0,0,10,60) ;
 160:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec FINE Offset    ;
 161:   ;
 162:  !**Move to PL Pos ;
 163:  CALL _SET_OFFS(0,0,1,60) ;
 164:L PR[20:*Rack PKPL] R[106:PL Spd]mm/sec FINE Offset    ;
 165:   ;
 166:  !***Drop Tote******************** ;
 167:  LBL[420] ;
 168:  !**Update Rack Slot Status ;
 169:  R[199:*RackSts-Reg]=R[21:*SlotNum]+200    ;
 170:  R[R[199]]=1    ;
 171:   ;
 172:  !***Open Grip*** ;
 173:  CALL _GRIP_PL    ;
 174:  R[5:*Grp-ToteID]=0    ;
 175:  R[100:*Tote-Sts ID]=0    ;
 176:  JMP LBL[430] ;
 177:   ;
 178:  !***Retreat Rack***************** ;
 179:  LBL[430] ;
 180:  CALL _SET_OFFS(0,0,(-15),60) ;
 181:L PR[20:*Rack PKPL] R[106:PL Spd]mm/sec CNT25 Offset    ;
 182:  CALL _SET_OFFS(0,(-125),(-15),60) ;
 183:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec CNT100 Offset    ;
 184:  CALL _SET_OFFS(0,(-475),(-15),60) ;
 185:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
 186:  JMP LBL[500] ;
 187:   ;
 188:   ;
 189:  !******************************** ;
 190:  !***Chk Rack Test Pos************ ;
 191:  LBL[500] ;
 192:  SELECT R[20:*RackNum]=1,JMP LBL[510] ;
 193:         =2,JMP LBL[520] ;
 194:         =3,JMP LBL[530] ;
 195:         =4,JMP LBL[590] ;
 196:         =5,JMP LBL[590] ;
 197:         =6,JMP LBL[590] ;
 198:   ;
 199:  LBL[510:Rack1] ;
 200:  IF (R[11:Tst-SlotInRack]>=26),JMP LBL[620] ;
 201:  IF (R[11:Tst-SlotInRack]<9),JMP LBL[610] ;
 202:  IF (R[11:Tst-SlotInRack]>=15 AND R[11:Tst-SlotInRack]<26),JMP LBL[610] ;
 203:  IF (R[11:Tst-SlotInRack]=9),JMP LBL[511] ;
 204:   ;
 205:  LBL[511:Go to Other Side-Trnst] ;
 206:  R[11:Tst-SlotInRack]=R[11:Tst-SlotInRack]+1    ;
 207:  JMP LBL[630] ;
 208:   ;
 209:  LBL[520:Rack2] ;
 210:  IF (R[11:Tst-SlotInRack]>=26),JMP LBL[620] ;
 211:  IF (R[11:Tst-SlotInRack]<28),JMP LBL[610] ;
 212:  JMP LBL[620] ;
 213:   ;
 214:  LBL[530:Rack3] ;
 215:  IF (R[11:Tst-SlotInRack]<25),JMP LBL[610] ;
 216:  JMP LBL[620] ;
 217:   ;
 218:  LBL[590:All Other Racks] ;
 219:  IF (R[11:Tst-SlotInRack]<28),JMP LBL[610] ;
 220:  JMP LBL[620] ;
 221:   ;
 222:   ;
 223:  !***Set Next Slot/Rack Pos******* ;
 224:  LBL[610:Next Slot] ;
 225:  R[11:Tst-SlotInRack]=R[11:Tst-SlotInRack]+1    ;
 226:  F[1001:OFF:Tst-Cont Rack]=(ON) ;
 227:  JMP LBL[100] ;
 228:   ;
 229:  LBL[620:Next Rack] ;
 230:  IF R[20:*RackNum]=6,JMP LBL[900] ;
 231:  R[20:*RackNum]=R[20:*RackNum]+1    ;
 232:  R[11:Tst-SlotInRack]=1    ;
 233:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
 234:  JMP LBL[630] ;
 235:   ;
 236:  LBL[630:Transit] ;
 237:L PR[21:*Rack Appr] R[101:EmptySpd-L]mm/sec CNT75    ;
 238:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
 239:  CALL _TRANSIT(R[24:*TransitAngle]) ;
 240:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
 241:  JMP LBL[100] ;
 242:   ;
 243:   ;
 244:  LBL[900:Done] ;
 245:L PR[21:*Rack Appr] R[101:EmptySpd-L]mm/sec CNT75    ;
 246:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
 247:  CALL _TRANSIT(R[24:*TransitAngle]) ;
 248:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
 249:  JMP LBL[999] ;
 250:   ;
 251:   ;
 252:  LBL[999] ;
/POS
/END
