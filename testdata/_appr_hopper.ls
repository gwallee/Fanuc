/PROG  _APPR_HOPPER
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Appr Hopper";
PROG_SIZE	= 2401;
CREATE		= DATE 26-07-08  TIME 11:16:20;
MODIFIED	= DATE 26-08-24  TIME 15:33:44;
FILE_NAME	= _APPR_RA;
VERSION		= 0;
LINE_COUNT	= 122;
MEMORY_SIZE	= 2825;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  !*****APPR HOPPER FOR DUMP******* ;
   2:  !AR1 Appr: 1=Hopper, 2=InspectPos ;
   3:  LBL[100] ;
   4:  F[700:OFF:Appr Error]=(OFF) ;
   5:  R[396:*AR1]=1    ;
   6:  !Set Appr Spds ;
   7:  IF (F[1:ON :Part in Grip]) THEN ;
   8:  R[113:*ApprSpd-L]=R[103:ToteSpd-L]    ;
   9:  R[114:*ApprSpd-J]=R[104:ToteSpd-J]    ;
  10:  ELSE ;
  11:  R[113:*ApprSpd-L]=R[101:EmptySpd-L]    ;
  12:  R[114:*ApprSpd-J]=R[102:EmptySpd-J]    ;
  13:  ENDIF ;
  14:   ;
  15:  !**Jump for Robot Pos ;
  16:  UFRAME_NUM=0 ;
  17:  UTOOL_NUM=1 ;
  18:  IF (DO[201:OFF:At Conv1/3 Appr]),JMP LBL[210] ;
  19:  IF (DO[202:OFF:At Recon Appr]),JMP LBL[220] ;
  20:  IF (DO[211:ON :At L-RacksApr]),JMP LBL[310] ;
  21:  IF (DO[212:OFF:At R-RacksApr]),JMP LBL[320] ;
  22:  IF (DO[204:OFF:At Inspct Pos]),JMP LBL[600] ;
  23:  IF (DO[205:OFF:At Hopper Appr]),JMP LBL[900] ;
  24:  IF (DO[37:OFF:At Transit]),JMP LBL[500] ;
  25:  !Recover ;
  26:  CALL _RECOVER    ;
  27:  JMP LBL[100] ;
  28:   ;
  29:   ;
  30:  !**********At Conveyors********** ;
  31:  !***At Infd/Outfd1 Appr*** ;
  32:  LBL[210] ;
  33:J PR[116:Appr-InfdOutfd-1] R[114:*ApprSpd-J]% CNT100    ;
  34:  CALL _SET_OFFS(0,0,325,60) ;
  35:L PR[116:Appr-InfdOutfd-1] R[113:*ApprSpd-L]mm/sec CNT100 Offset    ;
  36:  CALL _TRANSIT((-93)) ;
  37:  WAIT (DO[37:OFF:At Transit])    ;
  38:  JMP LBL[100] ;
  39:   ;
  40:  !***At Recon Appr*** ;
  41:  LBL[220] ;
  42:J PR[117:Appr-ReconConvs] R[114:*ApprSpd-J]% CNT50    ;
  43:L PR[41:Hopper Appr] R[113:*ApprSpd-L]mm/sec CNT100    ;
  44:  WAIT (DO[205:OFF:At Hopper Appr])    ;
  45:  JMP LBL[900] ;
  46:   ;
  47:   ;
  48:  !**********At Rack Appr********** ;
  49:  !***At Left Side Slot Appr*** ;
  50:  LBL[310] ;
  51:  IF R[396:*AR1]=2,JMP LBL[312] ;
  52:  JMP LBL[311] ;
  53:  !**Appr Hopper ;
  54:  LBL[311] ;
  55:J PR[137:Appr-Rack4-Left] R[114:*ApprSpd-J]% CNT100    ;
  56:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  57:  WAIT (DO[205:OFF:At Hopper Appr])    ;
  58:  JMP LBL[900] ;
  59:  !**Appr Inspect ;
  60:  LBL[312] ;
  61:J PR[137:Appr-Rack4-Left] R[114:*ApprSpd-J]% CNT100    ;
  62:J PR[45:Inspect Pos] R[114:*ApprSpd-J]% CNT100    ;
  63:  WAIT (DO[204:OFF:At Inspct Pos])    ;
  64:  JMP LBL[900] ;
  65:   ;
  66:  !***At Right Side Slot Appr*** ;
  67:  LBL[320] ;
  68:  IF R[396:*AR1]=2,JMP LBL[322] ;
  69:  JMP LBL[321] ;
  70:  !**Appr Hopper ;
  71:  LBL[321] ;
  72:J PR[138:Appr-Rack4-Right] R[114:*ApprSpd-J]% CNT100    ;
  73:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  74:  WAIT (DO[205:OFF:At Hopper Appr])    ;
  75:  JMP LBL[900] ;
  76:  !**Appr Inspect ;
  77:  LBL[322] ;
  78:J PR[138:Appr-Rack4-Right] R[114:*ApprSpd-J]% CNT100    ;
  79:J PR[45:Inspect Pos] R[114:*ApprSpd-J]% CNT100    ;
  80:  WAIT (DO[204:OFF:At Inspct Pos])    ;
  81:  JMP LBL[900] ;
  82:   ;
  83:   ;
  84:  !*******Transit to Hopper******** ;
  85:  LBL[500] ;
  86:  IF R[396:*AR1]=2,JMP LBL[502] ;
  87:  JMP LBL[501] ;
  88:  !**Appr Hopper ;
  89:  LBL[501] ;
  90:  CALL _TRANSIT(0) ;
  91:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  92:  WAIT (DO[205:OFF:At Hopper Appr])    ;
  93:  JMP LBL[900] ;
  94:  !**Appr Inspect ;
  95:  LBL[502] ;
  96:  CALL _TRANSIT(0) ;
  97:J PR[45:Inspect Pos] R[114:*ApprSpd-J]% CNT100    ;
  98:  WAIT (DO[204:OFF:At Inspct Pos])    ;
  99:  JMP LBL[900] ;
 100:   ;
 101:   ;
 102:  !********At Inspect Appr******** ;
 103:  LBL[600] ;
 104:  IF R[396:*AR1]=2,JMP LBL[900] ;
 105:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
 106:  WAIT (DO[205:OFF:At Hopper Appr])    ;
 107:  JMP LBL[900] ;
 108:   ;
 109:   ;
 110:  !***Appr Error******************* ;
 111:  LBL[700] ;
 112:  F[700:OFF:Appr Error]=(ON) ;
 113:  JMP LBL[999] ;
 114:   ;
 115:   ;
 116:  !***Appr Done******************** ;
 117:  LBL[900] ;
 118:  F[700:OFF:Appr Error]=(OFF) ;
 119:  JMP LBL[999] ;
 120:   ;
 121:   ;
 122:  LBL[999] ;
/POS
/END
