/PROG  _RECOV_REF_POS
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "At Reference Pos";
PROG_SIZE	= 3371;
CREATE		= DATE 20-12-29  TIME 00:06:20;
MODIFIED	= DATE 26-08-24  TIME 15:50:36;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 180;
MEMORY_SIZE	= 3803;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  !******Recov from RefPos****** ;
   2:  LBL[100] ;
   3:  IF (DO[33:OFF:At Home] OR DO[37:OFF:At Transit]),JMP LBL[999] ;
   4:  IF (DO[34:OFF:At TL Maint]),JMP LBL[110] ;
   5:  IF (DO[35:OFF:At Safe]),JMP LBL[120] ;
   6:  IF (DO[36:OFF:At Zero]),JMP LBL[130] ;
   7:   ;
   8:  !Chk:  Process RefPositions ;
   9:  IF (DO[201:OFF:At Conv1/3 Appr]),JMP LBL[210] ;
  10:  IF (DO[202:OFF:At Recon Appr]),JMP LBL[220] ;
  11:  IF (DO[203:OFF:At Scan Pos]),JMP LBL[230] ;
  12:  IF (DO[205:OFF:At Hopper Appr]),JMP LBL[250] ;
  13:  IF (DO[206:OFF:At Dump Pos] OR DO[204:OFF:At Inspct Pos]),JMP LBL[260] ;
  14:  IF (DO[207:OFF:At Dump-Divide Pos]),JMP LBL[270] ;
  15:  IF (DO[208:OFF:At Reject Appr]),JMP LBL[280] ;
  16:  IF (DO[211:ON :At L-RacksApr]),JMP LBL[310] ;
  17:  IF (DO[212:OFF:At R-RacksApr]),JMP LBL[320] ;
  18:  JMP LBL[999] ;
  19:   ;
  20:   ;
  21:  !********STANDARD REFPOS********* ;
  22:  !***At TL Maint ;
  23:  LBL[110:Tl Maint] ;
  24:J PR[2:TL Maint] R[118:RcvFast-J]% FINE    ;
  25:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  26:  PR[6,1:*Transit]=0    ;
  27:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  28:  WAIT (DO[37:OFF:At Transit])    ;
  29:  JMP LBL[999] ;
  30:   ;
  31:  !***At Safe ;
  32:  LBL[120:Safe] ;
  33:J PR[3:Safe] R[118:RcvFast-J]% FINE    ;
  34:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  35:  PR[6,1:*Transit]=0    ;
  36:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  37:  WAIT (DO[37:OFF:At Transit])    ;
  38:  JMP LBL[999] ;
  39:   ;
  40:  !***At Zero ;
  41:  LBL[130:Zero] ;
  42:J PR[4:Zero] R[118:RcvFast-J]% FINE    ;
  43:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  44:  PR[6,1:*Transit]=0    ;
  45:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  46:  WAIT (DO[37:OFF:At Transit])    ;
  47:  JMP LBL[999] ;
  48:   ;
  49:   ;
  50:  !*********PROCESS REFPOS********* ;
  51:  !***At Conv 1/3 Appr************* ;
  52:  LBL[210] ;
  53:  IF (!DO[201:OFF:At Conv1/3 Appr]),JMP LBL[100] ;
  54:  UFRAME_NUM=0 ;
  55:  UTOOL_NUM=1 ;
  56:J PR[116:Appr-InfdOutfd-1] R[118:RcvFast-J]% CNT50    ;
  57:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  58:  PR[6,1:*Transit]=(-93)    ;
  59:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  60:  WAIT (DO[37:OFF:At Transit])    ;
  61:  JMP LBL[999] ;
  62:   ;
  63:   ;
  64:  !***At Recon Convs Appr********** ;
  65:  LBL[220] ;
  66:  IF (!DO[202:OFF:At Recon Appr]),JMP LBL[100] ;
  67:  UFRAME_NUM=0 ;
  68:  UTOOL_NUM=1 ;
  69:J PR[117:Appr-ReconConvs] R[118:RcvFast-J]% CNT50    ;
  70:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  71:  PR[6,1:*Transit]=(-27)    ;
  72:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  73:  WAIT (DO[37:OFF:At Transit])    ;
  74:  JMP LBL[999] ;
  75:   ;
  76:   ;
  77:  !***At Scan Pos****************** ;
  78:  LBL[230] ;
  79:  IF (!DO[203:OFF:At Scan Pos]),JMP LBL[100] ;
  80:  UFRAME_NUM=0 ;
  81:  UTOOL_NUM=1 ;
  82:L PR[117:Appr-ReconConvs] R[117:RcvFast-L]mm/sec CNT50    ;
  83:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  84:  PR[6,1:*Transit]=(-27)    ;
  85:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  86:  WAIT (DO[37:OFF:At Transit])    ;
  87:  JMP LBL[999] ;
  88:   ;
  89:   ;
  90:  !***At Hopper Appr*************** ;
  91:  LBL[250] ;
  92:  IF (!DO[205:OFF:At Hopper Appr]),JMP LBL[100] ;
  93:  UFRAME_NUM=0 ;
  94:  UTOOL_NUM=1 ;
  95:J PR[41:Hopper Appr] R[118:RcvFast-J]% CNT50    ;
  96:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
  97:  PR[6,1:*Transit]=0    ;
  98:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
  99:  WAIT (DO[37:OFF:At Transit])    ;
 100:  JMP LBL[999] ;
 101:   ;
 102:   ;
 103:  !***At Inspect/Dump Pos********** ;
 104:  LBL[260] ;
 105:  IF (!DO[206:OFF:At Dump Pos] AND !DO[204:OFF:At Inspct Pos]),JMP LBL[100] ;
 106:  UFRAME_NUM=0 ;
 107:  UTOOL_NUM=1 ;
 108:L PR[43:Orig-Hopper-Nrml] R[117:RcvFast-L]mm/sec CNT50    ;
 109:  CALL _SET_OFFS(0,0,(-8),61) ;
 110:L PR[43:Orig-Hopper-Nrml] R[115:RcvSpd-L]mm/sec CNT25 Tool_Offset    ;
 111:  CALL _SET_OFFS((-800),0,(-8),61) ;
 112:L PR[43:Orig-Hopper-Nrml] R[117:RcvFast-L]mm/sec CNT50 Tool_Offset    ;
 113:L PR[41:Hopper Appr] R[117:RcvFast-L]mm/sec CNT50    ;
 114:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
 115:  PR[6,1:*Transit]=0    ;
 116:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
 117:  WAIT (DO[37:OFF:At Transit])    ;
 118:  JMP LBL[999] ;
 119:   ;
 120:   ;
 121:  !***At Divided Dump Pos********** ;
 122:  LBL[270] ;
 123:  IF (!DO[207:OFF:At Dump-Divide Pos]),JMP LBL[100] ;
 124:  UFRAME_NUM=0 ;
 125:  UTOOL_NUM=1 ;
 126:L PR[44:Orig-Hopper-Div] R[117:RcvFast-L]mm/sec CNT50    ;
 127:  CALL _SET_OFFS(0,(-10),(-8),61) ;
 128:L PR[44:Orig-Hopper-Div] R[115:RcvSpd-L]mm/sec CNT25 Tool_Offset    ;
 129:  CALL _SET_OFFS((-600),(-50),(-8),61) ;
 130:L PR[44:Orig-Hopper-Div] R[117:RcvFast-L]mm/sec CNT50 Tool_Offset    ;
 131:  CALL _SET_OFFS((-800),0,(-8),61) ;
 132:L PR[43:Orig-Hopper-Nrml] R[117:RcvFast-L]mm/sec CNT50 Tool_Offset    ;
 133:L PR[41:Hopper Appr] R[117:RcvFast-L]mm/sec CNT50    ;
 134:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
 135:  PR[6,1:*Transit]=0    ;
 136:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
 137:  WAIT (DO[37:OFF:At Transit])    ;
 138:  JMP LBL[999] ;
 139:   ;
 140:   ;
 141:  !***At Reject Appr*************** ;
 142:  LBL[280] ;
 143:  IF (!DO[208:OFF:At Reject Appr]),JMP LBL[100] ;
 144:  UFRAME_NUM=0 ;
 145:  UTOOL_NUM=1 ;
 146:J PR[71:Reject Appr] R[118:RcvFast-J]% CNT50    ;
 147:L PR[132:Appr-Rack1-Right] R[117:RcvFast-L]mm/sec CNT100    ;
 148:  WAIT (DO[212:OFF:At R-RacksApr])    ;
 149:  JMP LBL[100] ;
 150:   ;
 151:   ;
 152:  !***At Racks Appr-Left*********** ;
 153:  LBL[310] ;
 154:  IF (!DO[211:ON :At L-RacksApr]),JMP LBL[100] ;
 155:  UFRAME_NUM=0 ;
 156:  UTOOL_NUM=1 ;
 157:  PR[100:*JPOS]=JPOS    ;
 158:  R[91:*tempX]=PR[100,1:*JPOS]    ;
 159:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
 160:  PR[6,1:*Transit]=R[91:*tempX]    ;
 161:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
 162:  WAIT (DO[37:OFF:At Transit])    ;
 163:  JMP LBL[999] ;
 164:   ;
 165:   ;
 166:  !***At Racks Appr-Right********** ;
 167:  LBL[320] ;
 168:  IF (!DO[212:OFF:At R-RacksApr]),JMP LBL[100] ;
 169:  UFRAME_NUM=0 ;
 170:  UTOOL_NUM=1 ;
 171:  PR[100:*JPOS]=JPOS    ;
 172:  R[91:*tempX]=PR[100,1:*JPOS]    ;
 173:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
 174:  PR[6,1:*Transit]=R[91:*tempX]    ;
 175:J PR[6:*Transit] R[118:RcvFast-J]% FINE    ;
 176:  WAIT (DO[37:OFF:At Transit])    ;
 177:  JMP LBL[999] ;
 178:   ;
 179:   ;
 180:  LBL[999] ;
/POS
/END
