/PROG  _PK_CONV
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Pick Infd Convs";
PROG_SIZE	= 2789;
CREATE		= DATE 26-07-07  TIME 14:46:38;
MODIFIED	= DATE 26-07-24  TIME 15:53:18;
FILE_NAME	= _PK_RACK;
VERSION		= 0;
LINE_COUNT	= 134;
MEMORY_SIZE	= 3441;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : FALSE;
/MN
   1:  !******PICK TOTE FROM CONV******* ;
   2:  LBL[100] ;
   3:  IF (F[1:ON :Part in Grip]),JMP LBL[999] ;
   4:   ;
   5:   ;
   6:  !***Set Conv Pk Pos************** ;
   7:  LBL[150] ;
   8:  F[30:OFF:Conv PKPL Set]=(OFF) ;
   9:  CALL _SET_CONV_PK    ;
  10:  IF (F[30:OFF:Conv PKPL Set]),JMP LBL[200] ;
  11:  JMP LBL[999] ;
  12:   ;
  13:   ;
  14:  !***Appr Conveyor**************** ;
  15:  LBL[200] ;
  16:  IF (DO[201:OFF:At Conv1/3 Appr] OR DO[202:OFF:At Recon Appr]),JMP LBL[210] ;
  17:  CALL _APPR_CONVS(R[30:*ConvPKPL-ID]) ;
  18:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  19:  JMP LBL[200] ;
  20:   ;
  21:  !***Chk-At Appr for Conv Side*** ;
  22:  LBL[210] ;
  23:  IF ((R[30:*ConvPKPL-ID]=1 OR R[30:*ConvPKPL-ID]=3) AND DO[201:OFF:At Conv1/3 Appr]),JMP LBL[300] ;
  24:  IF ((R[30:*ConvPKPL-ID]=2 OR R[30:*ConvPKPL-ID]=4) AND DO[202:OFF:At Recon Appr]),JMP LBL[300] ;
  25:  IF ((R[30:*ConvPKPL-ID]=1 OR R[30:*ConvPKPL-ID]=3) AND DO[202:OFF:At Recon Appr]),JMP LBL[211] ;
  26:  IF ((R[30:*ConvPKPL-ID]=2 OR R[30:*ConvPKPL-ID]=4) AND DO[201:OFF:At Conv1/3 Appr]),JMP LBL[212] ;
  27:  JMP LBL[200] ;
  28:   ;
  29:  !**At In/Out-1, go to Recon ;
  30:  LBL[211] ;
  31:  UFRAME_NUM=3 ;
  32:  UTOOL_NUM=1 ;
  33:  CALL _SET_OFFS((-700),0,50,61) ;
  34:L PR[114:Orig-Outfd/Recon] R[101:EmptySpd-L]mm/sec CNT50 Tool_Offset    ;
  35:L PR[32:In/Out1 to Scan] R[101:EmptySpd-L]mm/sec CNT100    ;
  36:  CALL _SET_OFFS((-700),0,50,61) ;
  37:L PR[30:*Conv PKPL] R[101:EmptySpd-L]mm/sec CNT50 Tool_Offset    ;
  38:  JMP LBL[310] ;
  39:   ;
  40:  !**At Recon, go to In/Out-1 ;
  41:  LBL[212] ;
  42:  UFRAME_NUM=3 ;
  43:  UTOOL_NUM=1 ;
  44:  CALL _SET_OFFS((-700),0,50,61) ;
  45:L PR[111:Orig-Infd1] R[101:EmptySpd-L]mm/sec CNT50 Tool_Offset    ;
  46:L PR[32:In/Out1 to Scan] R[101:EmptySpd-L]mm/sec CNT100    ;
  47:  CALL _SET_OFFS((-700),0,50,61) ;
  48:L PR[30:*Conv PKPL] R[101:EmptySpd-L]mm/sec CNT50 Tool_Offset    ;
  49:  JMP LBL[310] ;
  50:   ;
  51:   ;
  52:  !***Move to Conv***************** ;
  53:  LBL[300] ;
  54:  UFRAME_NUM=3 ;
  55:  UTOOL_NUM=1 ;
  56:   ;
  57:J PR[31:*Conv Appr] R[102:EmptySpd-J]% CNT50    ;
  58:   ;
  59:  !**Move to Conv Entrance ;
  60:  LBL[310] ;
  61:  CALL _SET_OFFS((-475),0,(-15),61) ;
  62:L PR[30:*Conv PKPL] R[101:EmptySpd-L]mm/sec CNT50 Tool_Offset    ;
  63:  CALL _GRIP_OPEN    ;
  64:   ;
  65:  CALL _SET_OFFS((-250),0,(-15),61) ;
  66:L PR[30:*Conv PKPL] R[101:EmptySpd-L]mm/sec CNT100 Tool_Offset    ;
  67:  CALL _SET_OFFS(0,0,(-15),61) ;
  68:L PR[30:*Conv PKPL] R[107:Rtrt Spd]mm/sec FINE Tool_Offset    ;
  69:   ;
  70:  !**Move to PK Pos ;
  71:  LBL[350] ;
  72:  CALL _SET_OFFS(0,0,3,61) ;
  73:L PR[30:*Conv PKPL] R[105:Pk Spd]mm/sec FINE Tool_Offset    ;
  74:  JMP LBL[400] ;
  75:   ;
  76:   ;
  77:  !***Grip Tote******************** ;
  78:  LBL[400] ;
  79:  CALL _GRIP_PK    ;
  80:  R[13:*PrvPk-Conv/Rack]=1    ;
  81:   ;
  82:  !***Jump for Conv Pk hs*** ;
  83:  LBL[410] ;
  84:  IF R[30:*ConvPKPL-ID]=1,JMP LBL[411] ;
  85:  JMP LBL[412] ;
  86:   ;
  87:  !**Infd1 Pk hs ;
  88:  LBL[411] ;
  89:  R[5:*Grp-ToteID]=200    ;
  90:  R[100:*Tote-Sts ID]=10    ;
  91:  DO[17:OFF:Infd Picked]=ON ;
  92:  WAIT (!DI[17:OFF:Infd Pk Rdy])    ;
  93:  DO[17:OFF:Infd Picked]=OFF ;
  94:  JMP LBL[500] ;
  95:   ;
  96:  !**Recon Pk hs ;
  97:  LBL[412] ;
  98:  R[5:*Grp-ToteID]=201    ;
  99:  R[100:*Tote-Sts ID]=10    ;
 100:  DO[18:OFF:Recon Picked]=ON ;
 101:  WAIT (!DI[18:OFF:Recon Pk Rdy])    ;
 102:  DO[18:OFF:Recon Picked]=OFF ;
 103:  JMP LBL[500] ;
 104:   ;
 105:   ;
 106:  !***Retreat Conv***************** ;
 107:  LBL[500] ;
 108:  CALL _SET_OFFS(0,0,50,61) ;
 109:L PR[30:*Conv PKPL] R[105:Pk Spd]mm/sec CNT25 Tool_Offset    ;
 110:  CALL _SET_OFFS((-700),0,50,61) ;
 111:L PR[30:*Conv PKPL] R[103:ToteSpd-L]mm/sec CNT50 Tool_Offset    ;
 112:   ;
 113:  !Move to Scan BC ;
 114:  IF R[30:*ConvPKPL-ID]=2,JMP LBL[550] ;
 115:   ;
 116:  !**At Infd1, Appr Scanner ;
 117:L PR[32:In/Out1 to Scan] R[103:ToteSpd-L]mm/sec CNT100    ;
 118:   ;
 119:  !***Go to Scan Pos*** ;
 120:  LBL[550] ;
 121:L PR[35:Scan Pos] R[103:ToteSpd-L]mm/sec FINE    ;
 122:  WAIT (DO[203:OFF:At Scan Pos])    ;
 123:  JMP LBL[600] ;
 124:   ;
 125:   ;
 126:  !***Pick Done******************** ;
 127:  LBL[600] ;
 128:  F[30:OFF:Conv PKPL Set]=(OFF) ;
 129:  R[31:*Prev-ConvPK]=R[30:*ConvPKPL-ID]    ;
 130:  R[30:*ConvPKPL-ID]=0    ;
 131:  JMP LBL[999] ;
 132:   ;
 133:   ;
 134:  LBL[999] ;
/POS
/END
