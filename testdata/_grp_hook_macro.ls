/PROG  _GRP_HOOK_MACRO	  Macro
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 253;
CREATE		= DATE 26-06-24  TIME 14:07:56;
MODIFIED	= DATE 26-06-24  TIME 14:08:12;
FILE_NAME	= _GRP_CLM;
VERSION		= 0;
LINE_COUNT	= 2;
MEMORY_SIZE	= 617;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  DO[67:OFF:Ext Hook-Closed]=(!DO[67:OFF:Ext Hook-Closed]) ;
   2:  DO[68:OFF:Ret Hook-Open]=(!DO[67:OFF:Ext Hook-Closed]) ;
/POS
/END
