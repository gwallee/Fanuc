/PROG  TEST_RACKS
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 4003;
CREATE		= DATE 26-07-16  TIME 10:44:14;
MODIFIED	= DATE 26-07-17  TIME 03:30:08;
FILE_NAME	= TEST_RAC;
VERSION		= 0;
LINE_COUNT	= 188;
MEMORY_SIZE	= 4583;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  //R[20:*RackNum]=1    ;
   2:  //R[11:Tst-SlotInRack]=1    ;
   3:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
   4:   ;
   5:  !***Set Bin PKPL Pos************* ;
   6:  LBL[100] ;
   7:  CALL SET_RACK_TEST    ;
   8:  IF (!F[20:OFF:Rack PKPL-Set]),JMP LBL[7000] ;
   9:   ;
  10:   ;
  11:  !*********PICK FROM RACK********* ;
  12:  LBL[200] ;
  13:  IF (F[1001:OFF:Tst-Cont Rack]),JMP LBL[215] ;
  14:  CALL _APPR_RACKS(0) ;
  15:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  16:   ;
  17:  IF ((R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2) AND DO[211:ON :At L-RacksApr]),JMP LBL[210] ;
  18:  IF ((R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4) AND DO[212:OFF:At R-RacksApr]),JMP LBL[210] ;
  19:  JMP LBL[200] ;
  20:   ;
  21:  !***Move into Rack*************** ;
  22:  LBL[210] ;
  23:  UFRAME_NUM=R[20:*RackNum] ;
  24:  UTOOL_NUM=1 ;
  25:J PR[21:*Rack Appr] R[102:EmptySpd-J]% CNT50    ;
  26:   ;
  27:  LBL[215] ;
  28:  UFRAME_NUM=R[20:*RackNum] ;
  29:  UTOOL_NUM=1 ;
  30:  CALL _SET_OFFS(0,(-475),(-15),60) ;
  31:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
  32:  CALL _GRIP_OPEN    ;
  33:   ;
  34:  CALL _SET_OFFS(0,(-250),(-15),60) ;
  35:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
  36:  CALL _SET_OFFS(0,0,(-15),60) ;
  37:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec FINE Offset    ;
  38:   ;
  39:  !**Move to PK Pos ;
  40:  CALL _SET_OFFS(0,0,3,60) ;
  41:L PR[20:*Rack PKPL] R[105:Pk Spd]mm/sec FINE Offset    ;
  42:   ;
  43:  !***Grip Tote******************** ;
  44:  LBL[220] ;
  45:  CALL _GRIP_PK    ;
  46:  R[5:*Grp-ToteID]=R[21:*SlotNum]    ;
  47:  !**Update Rack Slot Status ;
  48:  R[199:*RackSts-Reg]=R[21:*SlotNum]+200    ;
  49:  R[R[199]]=0    ;
  50:  JMP LBL[250] ;
  51:   ;
  52:  !***Retreat Rack***************** ;
  53:  LBL[250] ;
  54:  CALL _SET_OFFS(0,0,10,60) ;
  55:L PR[20:*Rack PKPL] R[105:Pk Spd]mm/sec CNT25 Offset    ;
  56:  CALL _SET_OFFS(0,(-675),10,60) ;
  57:L PR[20:*Rack PKPL] R[111:RackPkSpd]mm/sec CNT50 Offset    ;
  58:   ;
  59:  //!**Return to Rack Appr ;
  60:  //L PR[21:*Rack Appr] R[103:ToteSpd-L]mm/sec CNT75    ;
  61:  //WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
  62:  //JMP LBL[600] ;
  63:  JMP LBL[415] ;
  64:   ;
  65:   ;
  66:  !******************************** ;
  67:  LBL[300] ;
  68:  !ADD RACK TO HOPPER HERE          ;
  69:   ;
  70:  !******************************** ;
  71:   ;
  72:   ;
  73:  !*********PLACE IN RACK********* ;
  74:  LBL[400] ;
  75:  CALL _APPR_RACKS(0) ;
  76:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  77:   ;
  78:  IF ((R[25:*Slot-Colmn]=1 OR R[25:*Slot-Colmn]=2) AND DO[211:ON :At L-RacksApr]),JMP LBL[410] ;
  79:  IF ((R[25:*Slot-Colmn]=3 OR R[25:*Slot-Colmn]=4) AND DO[212:OFF:At R-RacksApr]),JMP LBL[410] ;
  80:  JMP LBL[400] ;
  81:   ;
  82:  !***Move into Rack*************** ;
  83:  LBL[410] ;
  84:  UFRAME_NUM=R[20:*RackNum] ;
  85:  UTOOL_NUM=1 ;
  86:J PR[21:*Rack Appr] R[104:ToteSpd-J]% CNT50    ;
  87:   ;
  88:  LBL[415] ;
  89:  UFRAME_NUM=R[20:*RackNum] ;
  90:  UTOOL_NUM=1 ;
  91:  CALL _SET_OFFS(0,(-675),15,60) ;
  92:L PR[20:*Rack PKPL] R[103:ToteSpd-L]mm/sec CNT50 Offset    ;
  93:  CALL _SET_OFFS(0,(-600),10,60) ;
  94:L PR[20:*Rack PKPL] R[103:ToteSpd-L]mm/sec CNT50 Offset    ;
  95:  CALL _SET_OFFS(0,0,10,60) ;
  96:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec FINE Offset    ;
  97:   ;
  98:  !**Move to PL Pos ;
  99:  CALL _SET_OFFS(0,0,1,60) ;
 100:L PR[20:*Rack PKPL] R[106:PL Spd]mm/sec FINE Offset    ;
 101:   ;
 102:  !***Drop Tote******************** ;
 103:  LBL[420] ;
 104:  !**Update Rack Slot Status ;
 105:  R[199:*RackSts-Reg]=R[21:*SlotNum]+200    ;
 106:  R[R[199]]=1    ;
 107:   ;
 108:  !***Open Grip*** ;
 109:  CALL _GRIP_PL    ;
 110:  R[5:*Grp-ToteID]=0    ;
 111:  R[100:*Tote-Sts ID]=0    ;
 112:  JMP LBL[430] ;
 113:   ;
 114:  !***Retreat Rack***************** ;
 115:  LBL[430] ;
 116:  CALL _SET_OFFS(0,0,(-15),60) ;
 117:L PR[20:*Rack PKPL] R[106:PL Spd]mm/sec CNT25 Offset    ;
 118:  CALL _SET_OFFS(0,(-125),(-15),60) ;
 119:L PR[20:*Rack PKPL] R[110:RackPLSpd]mm/sec CNT100 Offset    ;
 120:  CALL _SET_OFFS(0,(-475),(-15),60) ;
 121:L PR[20:*Rack PKPL] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
 122:  JMP LBL[500] ;
 123:   ;
 124:   ;
 125:  !******************************** ;
 126:  !***Chk Rack Test Pos************ ;
 127:  LBL[500] ;
 128:  SELECT R[20:*RackNum]=1,JMP LBL[510] ;
 129:         =2,JMP LBL[520] ;
 130:         =3,JMP LBL[530] ;
 131:         =4,JMP LBL[590] ;
 132:         =5,JMP LBL[590] ;
 133:         =6,JMP LBL[590] ;
 134:   ;
 135:  LBL[510:Rack1] ;
 136:  IF (R[11:Tst-SlotInRack]>=26),JMP LBL[620] ;
 137:  IF (R[11:Tst-SlotInRack]<9),JMP LBL[610] ;
 138:  IF (R[11:Tst-SlotInRack]>=15 AND R[11:Tst-SlotInRack]<26),JMP LBL[610] ;
 139:  IF (R[11:Tst-SlotInRack]=9),JMP LBL[511] ;
 140:   ;
 141:  LBL[511:Go to Other Side-Trnst] ;
 142:  R[11:Tst-SlotInRack]=R[11:Tst-SlotInRack]+1    ;
 143:  JMP LBL[630] ;
 144:   ;
 145:  LBL[520:Rack2] ;
 146:  IF (R[11:Tst-SlotInRack]>=26),JMP LBL[620] ;
 147:  IF (R[11:Tst-SlotInRack]<28),JMP LBL[610] ;
 148:  JMP LBL[620] ;
 149:   ;
 150:  LBL[530:Rack3] ;
 151:  IF (R[11:Tst-SlotInRack]<25),JMP LBL[610] ;
 152:  JMP LBL[620] ;
 153:   ;
 154:  LBL[590:All Other Racks] ;
 155:  IF (R[11:Tst-SlotInRack]<28),JMP LBL[610] ;
 156:  JMP LBL[620] ;
 157:   ;
 158:   ;
 159:  !***Set Next Slot/Rack Pos******* ;
 160:  LBL[610:Next Slot] ;
 161:  R[11:Tst-SlotInRack]=R[11:Tst-SlotInRack]+1    ;
 162:  F[1001:OFF:Tst-Cont Rack]=(ON) ;
 163:  JMP LBL[100] ;
 164:   ;
 165:  LBL[620:Next Rack] ;
 166:  IF R[20:*RackNum]=6,JMP LBL[900] ;
 167:  R[20:*RackNum]=R[20:*RackNum]+1    ;
 168:  R[11:Tst-SlotInRack]=1    ;
 169:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
 170:  JMP LBL[630] ;
 171:   ;
 172:  LBL[630:Transit] ;
 173:L PR[21:*Rack Appr] R[101:EmptySpd-L]mm/sec CNT75    ;
 174:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
 175:  CALL _TRANSIT(R[24:*TransitAngle]) ;
 176:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
 177:  JMP LBL[100] ;
 178:   ;
 179:   ;
 180:  LBL[900:Done] ;
 181:L PR[21:*Rack Appr] R[101:EmptySpd-L]mm/sec CNT75    ;
 182:  WAIT (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr])    ;
 183:  CALL _TRANSIT(R[24:*TransitAngle]) ;
 184:  F[1001:OFF:Tst-Cont Rack]=(OFF) ;
 185:  JMP LBL[999] ;
 186:   ;
 187:   ;
 188:  LBL[999] ;
/POS
/END
