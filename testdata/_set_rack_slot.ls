/MN
   1:  !*******SET RACK PKPL SLOT******* ;
   2:  LBL[100] ;
   3:  F[21:OFF:Rack Slot-Set]=(OFF) ;
   4:  !**Jump for Rack to PKPL at ;
   5:  SELECT R[20:*RackNum]=1,JMP LBL[210] ;
   6:         =2,JMP LBL[220] ;
   7:         =3,JMP LBL[230] ;
   8:         =4,JMP LBL[240] ;
   9:         =5,JMP LBL[250] ;
  10:         =6,JMP LBL[260] ;
  11:  JMP LBL[700] ;
  12:   ;
  13:  !***Rack-1 (Door)**************** ;
  14:  LBL[210] ;
  15:  !Jump for Column ;
