  17:         =2,JMP LBL[212] ;
  18:         =3,JMP LBL[213] ;
  19:         =4,JMP LBL[214] ;
  20:  JMP LBL[700] ;
  21:   ;
  22:  !**Column 1-Chk Row  ;
