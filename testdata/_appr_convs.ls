/PROG  _APPR_CONVS
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Appr InOut Convs";
PROG_SIZE	= 3697;
CREATE		= DATE 26-07-07  TIME 14:47:14;
MODIFIED	= DATE 26-07-24  TIME 15:44:06;
FILE_NAME	= _APPR_RA;
VERSION		= 0;
LINE_COUNT	= 183;
MEMORY_SIZE	= 4265;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  !******APPR CONVS FOR PKPL******* ;
   2:  !AR1 Appr: 1/3=InOut1, 2/4=Recon ;
   3:  !AR1 Appr: 5=Scanner ;
   4:  LBL[100] ;
   5:  F[700:OFF:Appr Error]=(OFF) ;
   6:  R[396:*AR1]=AR[1]    ;
   7:  !Set Appr Spds ;
   8:  IF (F[1:ON :Part in Grip]) THEN ;
   9:  R[113:*ApprSpd-L]=R[103:ToteSpd-L]    ;
  10:  R[114:*ApprSpd-J]=R[104:ToteSpd-J]    ;
  11:  ELSE ;
  12:  R[113:*ApprSpd-L]=R[101:EmptySpd-L]    ;
  13:  R[114:*ApprSpd-J]=R[102:EmptySpd-J]    ;
  14:  ENDIF ;
  15:   ;
  16:  !**Jump for Robot Pos ;
  17:  UFRAME_NUM=0 ;
  18:  UTOOL_NUM=1 ;
  19:  IF (DO[201:OFF:At Conv1/3 Appr] OR DO[202:OFF:At Recon Appr]),JMP LBL[600] ;
  20:  IF (DO[211:ON :At L-RacksApr] OR DO[212:OFF:At R-RacksApr]),JMP LBL[200] ;
  21:  IF (DO[205:OFF:At Hopper Appr]),JMP LBL[300] ;
  22:  IF (DO[203:OFF:At Scan Pos]),JMP LBL[400] ;
  23:  IF (DO[37:OFF:At Transit]),JMP LBL[500] ;
  24:  !Recover ;
  25:  CALL _RECOVER    ;
  26:  JMP LBL[100] ;
  27:   ;
  28:   ;
  29:  !***At Rack Appr***************** ;
  30:  LBL[200] ;
  31:  IF (R[396:*AR1]=1 OR R[396:*AR1]=3),JMP LBL[210] ;
  32:  IF (R[396:*AR1]=2 OR R[396:*AR1]=4 OR R[396:*AR1]=5),JMP LBL[220] ;
  33:  JMP LBL[700] ;
  34:   ;
  35:  !***Appr Infd/Outfd-1*** ;
  36:  LBL[210] ;
  37:  IF (DO[211:ON :At L-RacksApr]),JMP LBL[250] ;
  38:  IF (!DO[212:OFF:At R-RacksApr]),JMP LBL[100] ;
  39:  !At R-RackAppr, go to ConvAppr ;
  40:J PR[136:Appr-Rack3-Right] R[114:*ApprSpd-J]% CNT100    ;
  41:  UFRAME_NUM=3 ;
  42:  UTOOL_NUM=1 ;
  43:L PR[116:Appr-InfdOutfd-1] R[113:*ApprSpd-L]mm/sec CNT100    ;
  44:  WAIT (DO[201:OFF:At Conv1/3 Appr])    ;
  45:  JMP LBL[900] ;
  46:   ;
  47:  !***Appr Recon Convs*** ;
  48:  LBL[220] ;
  49:  IF (DO[212:OFF:At R-RacksApr]),JMP LBL[250] ;
  50:  IF (!DO[211:ON :At L-RacksApr]),JMP LBL[100] ;
  51:  !At L-RackAppr, go to ReconAppr ;
  52:J PR[135:Appr-Rack3-Left] R[114:*ApprSpd-J]% CNT100    ;
  53:  UFRAME_NUM=3 ;
  54:  UTOOL_NUM=1 ;
  55:L PR[117:Appr-ReconConvs] R[113:*ApprSpd-L]mm/sec CNT100    ;
  56:  WAIT (DO[202:OFF:At Recon Appr])    ;
  57:  JMP LBL[900] ;
  58:   ;
  59:  !***Return to Transit*** ;
  60:  LBL[250] ;
  61:  PR[100:*JPOS]=JPOS    ;
  62:  R[99:*temp]=PR[100,1:*JPOS]    ;
  63:  CALL _TRANSIT(R[99:*temp]) ;
  64:  WAIT (DO[37:OFF:At Transit])    ;
  65:  JMP LBL[100] ;
  66:   ;
  67:   ;
  68:  !***At Hopper Appr*************** ;
  69:  LBL[300] ;
  70:  IF (R[396:*AR1]=1 OR R[396:*AR1]=3),JMP LBL[310] ;
  71:  IF (R[396:*AR1]=2 OR R[396:*AR1]=4 OR R[396:*AR1]=5),JMP LBL[320] ;
  72:  JMP LBL[700] ;
  73:   ;
  74:  !***Appr Infd/Outfd-1*** ;
  75:  LBL[310] ;
  76:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  77:  !Go to Transit ;
  78:  CALL _TRANSIT(0) ;
  79:  WAIT (DO[37:OFF:At Transit])    ;
  80:  JMP LBL[100] ;
  81:   ;
  82:  !***Appr Recon Convs*** ;
  83:  LBL[320] ;
  84:J PR[41:Hopper Appr] R[114:*ApprSpd-J]% CNT100    ;
  85:  !Go Straight to Recon Appr ;
  86:  UFRAME_NUM=3 ;
  87:  UTOOL_NUM=1 ;
  88:L PR[117:Appr-ReconConvs] R[113:*ApprSpd-L]mm/sec CNT100    ;
  89:  WAIT (DO[202:OFF:At Recon Appr])    ;
  90:  JMP LBL[900] ;
  91:   ;
  92:   ;
  93:  !***At Scan Pos****************** ;
  94:  LBL[400] ;
  95:J PR[35:Scan Pos] R[114:*ApprSpd-J]% CNT50    ;
  96:  UFRAME_NUM=3 ;
  97:  UTOOL_NUM=1 ;
  98:L PR[117:Appr-ReconConvs] R[113:*ApprSpd-L]mm/sec CNT50    ;
  99:  WAIT (DO[202:OFF:At Recon Appr])    ;
 100:  JMP LBL[100] ;
 101:   ;
 102:   ;
 103:  !***Transit to Conv************** ;
 104:  LBL[500] ;
 105:  IF (R[396:*AR1]=1 OR R[396:*AR1]=3),JMP LBL[510] ;
 106:  IF (R[396:*AR1]=2 OR R[396:*AR1]=4 OR R[396:*AR1]=5),JMP LBL[520] ;
 107:  JMP LBL[700] ;
 108:   ;
 109:  !***Appr Infd/Outfd-1*** ;
 110:  LBL[510] ;
 111:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
 112:  PR[6,1:*Transit]=(-93)    ;
 113:J PR[6:*Transit] R[108:Transit Spd]% CNT50    ;
 114:  UFRAME_NUM=3 ;
 115:  UTOOL_NUM=1 ;
 116:  CALL _SET_OFFS(0,0,325,60) ;
 117:J PR[116:Appr-InfdOutfd-1] R[114:*ApprSpd-J]% CNT100 Offset    ;
 118:L PR[116:Appr-InfdOutfd-1] R[113:*ApprSpd-L]mm/sec CNT100    ;
 119:  WAIT (DO[201:OFF:At Conv1/3 Appr])    ;
 120:  JMP LBL[900] ;
 121:   ;
 122:  !***Appr Recon Convs*** ;
 123:  LBL[520] ;
 124:  PR[6:*Transit]=PR[5:Trans-Origin]    ;
 125:  PR[6,1:*Transit]=(-27)    ;
 126:J PR[6:*Transit] R[108:Transit Spd]% CNT50    ;
 127:  UFRAME_NUM=3 ;
 128:  UTOOL_NUM=1 ;
 129:  CALL _SET_OFFS(0,0,325,60) ;
 130:J PR[117:Appr-ReconConvs] R[114:*ApprSpd-J]% CNT100 Offset    ;
 131:L PR[117:Appr-ReconConvs] R[113:*ApprSpd-L]mm/sec CNT100    ;
 132:  WAIT (DO[202:OFF:At Recon Appr])    ;
 133:  JMP LBL[900] ;
 134:   ;
 135:   ;
 136:  !***At Conv Appr***************** ;
 137:  LBL[600] ;
 138:  IF (R[396:*AR1]=1 OR R[396:*AR1]=3),JMP LBL[610] ;
 139:  IF (R[396:*AR1]=2 OR R[396:*AR1]=4 OR R[396:*AR1]=5),JMP LBL[620] ;
 140:  JMP LBL[700] ;
 141:   ;
 142:  !***Appr Infd/Outfd-1*** ;
 143:  LBL[610] ;
 144:  IF (DO[201:OFF:At Conv1/3 Appr]),JMP LBL[900] ;
 145:  IF (!DO[202:OFF:At Recon Appr]),JMP LBL[100] ;
 146:  !At Recon, go to Transit ;
 147:  UFRAME_NUM=3 ;
 148:  UTOOL_NUM=1 ;
 149:J PR[117:Appr-ReconConvs] R[114:*ApprSpd-J]% CNT25    ;
 150:  CALL _SET_OFFS(0,0,325,60) ;
 151:L PR[117:Appr-ReconConvs] R[113:*ApprSpd-L]mm/sec CNT100 Offset    ;
 152:  CALL _TRANSIT((-27)) ;
 153:  WAIT (DO[37:OFF:At Transit])    ;
 154:  JMP LBL[100] ;
 155:   ;
 156:  !***Appr Recon Convs*** ;
 157:  LBL[620] ;
 158:  IF (DO[202:OFF:At Recon Appr]),JMP LBL[900] ;
 159:  IF (!DO[201:OFF:At Conv1/3 Appr]),JMP LBL[100] ;
 160:  !At Infd/Outfd-1, go to Transit ;
 161:  UFRAME_NUM=3 ;
 162:  UTOOL_NUM=1 ;
 163:J PR[116:Appr-InfdOutfd-1] R[114:*ApprSpd-J]% CNT25    ;
 164:  CALL _SET_OFFS(0,0,325,60) ;
 165:L PR[116:Appr-InfdOutfd-1] R[113:*ApprSpd-L]mm/sec CNT100 Offset    ;
 166:  CALL _TRANSIT((-93)) ;
 167:  WAIT (DO[37:OFF:At Transit])    ;
 168:  JMP LBL[100] ;
 169:   ;
 170:   ;
 171:  !***Appr Error******************* ;
 172:  LBL[700] ;
 173:  F[700:OFF:Appr Error]=(ON) ;
 174:  JMP LBL[999] ;
 175:   ;
 176:   ;
 177:  !***Appr Done******************** ;
 178:  LBL[900] ;
 179:  F[700:OFF:Appr Error]=(OFF) ;
 180:  JMP LBL[999] ;
 181:   ;
 182:   ;
 183:  LBL[999] ;
/POS
/END
