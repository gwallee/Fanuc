/PROG  _PL_REJECT
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "PL in RejectNest";
PROG_SIZE	= 3315;
CREATE		= DATE 26-07-13  TIME 11:26:00;
MODIFIED	= DATE 26-07-24  TIME 03:33:24;
FILE_NAME	= _PL_RACK;
VERSION		= 0;
LINE_COUNT	= 175;
MEMORY_SIZE	= 3931;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : FALSE;
/MN
   1:  !******PLACE TOTE IN REJECT****** ;
   2:  LBL[100] ;
   3:  R[75:*RdyWait-Timer]=0    ;
   4:   ;
   5:  !***Appr Reject****************** ;
   6:  LBL[110] ;
   7:  IF (DO[208:OFF:At Reject Appr]),JMP LBL[150] ;
   8:  IF (DO[212:OFF:At R-RacksApr]),JMP LBL[120] ;
   9:  CALL _APPR_RACKS(7) ;
  10:  JMP LBL[110] ;
  11:   ;
  12:  !***At R-Racks Appr*** ;
  13:  LBL[120] ;
  14:  UFRAME_NUM=1 ;
  15:  UTOOL_NUM=1 ;
  16:   ;
  17:J PR[132:Appr-Rack1-Right] R[104:ToteSpd-J]% CNT50    ;
  18:  JMP LBL[150] ;
  19:   ;
  20:  !***Goto Reject Appr*** ;
  21:  LBL[150] ;
  22:  UFRAME_NUM=1 ;
  23:  UTOOL_NUM=1 ;
  24:   ;
  25:L PR[71:Reject Appr] R[103:ToteSpd-L]mm/sec CNT50    ;
  26:  WAIT (DO[208:OFF:At Reject Appr])    ;
  27:  JMP LBL[200] ;
  28:   ;
  29:   ;
  30:  !***Wait-Reject Rdy************** ;
  31:  LBL[200] ;
  32:  DO[29:OFF:Reject Placed]=OFF ;
  33:  F[104:OFF:Sys Chks Ran]=(OFF) ;
  34:  IF (F[101:OFF:Sys Chks]),CALL _SYS_CHECKS ;
  35:  IF (F[104:OFF:Sys Chks Ran]),JMP LBL[100] ;
  36:   ;
  37:  !**Chk Reject Status=0 ;
  38:  LBL[210] ;
  39:  IF R[70:*Rjct Nest Sts]=0,JMP LBL[220] ;
  40:  JMP LBL[260] ;
  41:   ;
  42:  !**Chk Rjct DCS Disabled ;
  43:  LBL[220] ;
  44:  IF (DI[121:ON :DCS-Rjct dsbl]),JMP LBL[250] ;
  45:  JMP LBL[260] ;
  46:   ;
  47:  !***Reject PL Ready*** ;
  48:  LBL[250] ;
  49:  R[75:*RdyWait-Timer]=0    ;
  50:  R[71:*ToteInNst-StsID]=0    ;
  51:  JMP LBL[300] ;
  52:   ;
  53:  !***Reject PL Not Ready*** ;
  54:  LBL[260] ;
  55:  WAIT    .25(sec) ;
  56:  R[75:*RdyWait-Timer]=R[75:*RdyWait-Timer]+.25    ;
  57:  !Chk Rdy-Wait Timer ;
  58:  IF R[75:*RdyWait-Timer]>=5,JMP LBL[270] ;
  59:  JMP LBL[200] ;
  60:   ;
  61:  !***Not Ready-Alarm*** ;
  62:  LBL[270] ;
  63:  R[75:*RdyWait-Timer]=0    ;
  64:  DO[59:OFF:Rjct Not Rdy]=ON ;
  65:  PAUSE ;
  66:  DO[59:OFF:Rjct Not Rdy]=OFF ;
  67:  JMP LBL[100] ;
  68:   ;
  69:   ;
  70:  !***Move into Rack*************** ;
  71:  LBL[300] ;
  72:  IF (!DO[208:OFF:At Reject Appr]),JMP LBL[100] ;
  73:   ;
  74:  UFRAME_NUM=1 ;
  75:  UTOOL_NUM=1 ;
  76:   ;
  77:  CALL _SET_OFFS(0,(-675),15,60) ;
  78:L PR[70:Reject Nest] R[103:ToteSpd-L]mm/sec CNT25 Offset    ;
  79:   ;
  80:  !**Relax Clamp to Settle Tote ;
  81:  DO[65:OFF:Ext Clamp-Up]=OFF ;
  82:  DO[66:OFF:Ret Clamp-Down]=ON ;
  83:  DO[67:OFF:Ext Hook-Closed]=OFF ;
  84:   ;
  85:  CALL _SET_OFFS(0,(-625),12,60) ;
  86:L PR[70:Reject Nest] R[110:RackPLSpd]mm/sec CNT50 Offset    ;
  87:   ;
  88:  !**Relax Clamp, Re-Hook Tote ;
  89:  DO[66:OFF:Ret Clamp-Down]=OFF ;
  90:  DO[68:OFF:Ret Hook-Open]=OFF ;
  91:  DO[67:OFF:Ext Hook-Closed]=ON ;
  92:   ;
  93:  CALL _SET_OFFS(0,(-550),10,60) ;
  94:L PR[70:Reject Nest] R[110:RackPLSpd]mm/sec CNT50 Offset    ;
  95:   ;
  96:  !***Wait-In DCS ZN*** ;
  97:  LBL[310] ;
  98:  CALL _SET_WAIT(200) ;
  99:  WAIT (DO[43:OFF:At Reject]) TIMEOUT,LBL[731] ;
 100:   ;
 101:  !**Re-Clamp ;
 102:  DO[66:OFF:Ret Clamp-Down]=ON ;
 103:   ;
 104:  CALL _SET_OFFS(0,(-50),5,60) ;
 105:L PR[70:Reject Nest] R[110:RackPLSpd]mm/sec CNT100 Offset    ;
 106:   ;
 107:  !**Relax Clamp/Hook ;
 108:  DO[66:OFF:Ret Clamp-Down]=OFF ;
 109:  DO[67:OFF:Ext Hook-Closed]=OFF ;
 110:   ;
 111:  !**Move to PL Pos ;
 112:  LBL[350] ;
 113:  CALL _SET_OFFS(0,0,1,60) ;
 114:L PR[70:Reject Nest] R[106:PL Spd]mm/sec FINE Offset    ;
 115:  JMP LBL[400] ;
 116:   ;
 117:   ;
 118:  !***Drop Tote******************** ;
 119:  LBL[400] ;
 120:  !**Set Reject Sts to Grip Tote ID ;
 121:  IF (R[5:*Grp-ToteID]>0) THEN ;
 122:  R[70:*Rjct Nest Sts]=R[5:*Grp-ToteID]    ;
 123:  ELSE ;
 124:  R[70:*Rjct Nest Sts]=1    ;
 125:  ENDIF ;
 126:  !**Save Tote Sts Placed in Reject ;
 127:  R[71:*ToteInNst-StsID]=R[100:*Tote-Sts ID]    ;
 128:   ;
 129:  !***Reject PL hs*** ;
 130:  LBL[410] ;
 131:  DO[29:OFF:Reject Placed]=ON ;
 132:  WAIT (DI[29:OFF:Reject PL Ack])    ;
 133:  DO[29:OFF:Reject Placed]=OFF ;
 134:   ;
 135:  !***Open Grip*** ;
 136:  CALL _GRIP_PL    ;
 137:  R[5:*Grp-ToteID]=0    ;
 138:  R[100:*Tote-Sts ID]=0    ;
 139:  JMP LBL[500] ;
 140:   ;
 141:   ;
 142:  !***Retreat Rack***************** ;
 143:  LBL[500] ;
 144:  CALL _SET_OFFS(0,0,(-15),60) ;
 145:L PR[70:Reject Nest] R[106:PL Spd]mm/sec CNT25 Offset    ;
 146:  CALL _SET_OFFS(0,(-125),(-15),60) ;
 147:L PR[70:Reject Nest] R[110:RackPLSpd]mm/sec CNT100 Offset    ;
 148:  CALL _SET_OFFS(0,(-500),(-15),60) ;
 149:L PR[70:Reject Nest] R[101:EmptySpd-L]mm/sec CNT50 Offset    ;
 150:   ;
 151:   ;
 152:  !**Return to Rack Appr ;
 153:L PR[71:Reject Appr] R[101:EmptySpd-L]mm/sec CNT100    ;
 154:L PR[132:Appr-Rack1-Right] R[101:EmptySpd-L]mm/sec CNT75    ;
 155:  WAIT (DO[212:OFF:At R-RacksApr])    ;
 156:  JMP LBL[600] ;
 157:   ;
 158:   ;
 159:  !***Place Done******************* ;
 160:  LBL[600] ;
 161:  F[70:OFF:Rjct PL-Set]=(OFF) ;
 162:  R[75:*RdyWait-Timer]=0    ;
 163:  JMP LBL[999] ;
 164:   ;
 165:   ;
 166:  !*************ERRORS************* ;
 167:  !**Err-Not in DCS ;
 168:  LBL[731] ;
 169:  DO[54:OFF:DCS Err]=ON ;
 170:  PAUSE ;
 171:  DO[54:OFF:DCS Err]=OFF ;
 172:  JMP LBL[310] ;
 173:   ;
 174:   ;
 175:  LBL[999] ;
/POS
/END
