/PROG  SET_RACK_TEST
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 3305;
CREATE		= DATE 26-07-16  TIME 10:43:44;
MODIFIED	= DATE 26-07-16  TIME 23:59:32;
FILE_NAME	= TEST_SET;
VERSION		= 0;
LINE_COUNT	= 136;
MEMORY_SIZE	= 3785;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  LBL[100] ;
   2:  F[20:OFF:Rack PKPL-Set]=(OFF) ;
   3:  !***Jump for Rack to test*** ;
   4:  LBL[105] ;
   5:  SELECT R[20:*RackNum]=1,JMP LBL[110] ;
   6:         =2,JMP LBL[120] ;
   7:         =3,JMP LBL[130] ;
   8:         =4,JMP LBL[140] ;
   9:         =5,JMP LBL[150] ;
  10:         =6,JMP LBL[160] ;
  11:  JMP LBL[700] ;
  12:   ;
  13:  !***Rack-1 (Door)**************** ;
  14:  LBL[110] ;
  15:  !**Adjust for Missing Slots ;
  16:  IF (R[11:Tst-SlotInRack]>9 AND R[11:Tst-SlotInRack]<15),R[11:Tst-SlotInRack]=(15) ;
  17:  IF (R[11:Tst-SlotInRack]>16 AND R[11:Tst-SlotInRack]<22),R[11:Tst-SlotInRack]=(22) ;
  18:  !**Adjust for Unpickable Slots ;
  19:  IF (R[11:Tst-SlotInRack]>26) THEN ;
  20:  R[20:*RackNum]=R[20:*RackNum]+1    ;
  21:  R[11:Tst-SlotInRack]=1    ;
  22:  JMP LBL[100] ;
  23:  ENDIF ;
  24:  !Set Column/Row Num of Slot ;
  25:  R[25:*Slot-Colmn]=(((R[11:Tst-SlotInRack]-1) DIV 7)+1) ;
  26:  R[26:*Slot-Row]=(((R[11:Tst-SlotInRack]-1) MOD 7)+1) ;
  27:  JMP LBL[200] ;
  28:   ;
  29:  !***Rack-2 (Full)**************** ;
  30:  LBL[120] ;
  31:  !**Adjust for Unpickable Slots ;
  32:  IF (R[11:Tst-SlotInRack]>26) THEN ;
  33:  R[20:*RackNum]=R[20:*RackNum]+1    ;
  34:  R[11:Tst-SlotInRack]=1    ;
  35:  JMP LBL[100] ;
  36:  ENDIF ;
  37:  !Set Column/Row Num of Slot ;
  38:  R[25:*Slot-Colmn]=(((R[11:Tst-SlotInRack]-1) DIV 7)+1) ;
  39:  R[26:*Slot-Row]=(((R[11:Tst-SlotInRack]-1) MOD 7)+1) ;
  40:  JMP LBL[200] ;
  41:   ;
  42:  !***Rack-3 (Convs)*************** ;
  43:  LBL[130] ;
  44:  !**Adjust for Missing Slots ;
  45:  IF (R[11:Tst-SlotInRack]>4 AND R[11:Tst-SlotInRack]<8),R[11:Tst-SlotInRack]=(8) ;
  46:  IF (R[11:Tst-SlotInRack]>11 AND R[11:Tst-SlotInRack]<15),R[11:Tst-SlotInRack]=(15) ;
  47:  IF (R[11:Tst-SlotInRack]>18 AND R[11:Tst-SlotInRack]<22),R[11:Tst-SlotInRack]=(22) ;
  48:  IF (R[11:Tst-SlotInRack]>24) THEN ;
  49:  R[20:*RackNum]=R[20:*RackNum]+1    ;
  50:  R[11:Tst-SlotInRack]=1    ;
  51:  JMP LBL[100] ;
  52:  ENDIF ;
  53:  !Set Column/Row Num of Slot ;
  54:  R[25:*Slot-Colmn]=(((R[11:Tst-SlotInRack]-1) DIV 7)+1) ;
  55:  R[26:*Slot-Row]=(((R[11:Tst-SlotInRack]-1) MOD 7)+1) ;
  56:  JMP LBL[200] ;
  57:   ;
  58:  !***Rack-4 (Hopper)************** ;
  59:  LBL[140] ;
  60:  !**Adjust for Missing Slots ;
  61:  IF (R[11:Tst-SlotInRack]>1 AND R[11:Tst-SlotInRack]<6),R[11:Tst-SlotInRack]=(6) ;
  62:  IF (R[11:Tst-SlotInRack]>8 AND R[11:Tst-SlotInRack]<13),R[11:Tst-SlotInRack]=(13) ;
  63:  IF (R[11:Tst-SlotInRack]>15 AND R[11:Tst-SlotInRack]<20),R[11:Tst-SlotInRack]=(20) ;
  64:  !Set Column/Row Num of Slot ;
  65:  R[25:*Slot-Colmn]=(((R[11:Tst-SlotInRack]-1) DIV 7)+1) ;
  66:  R[26:*Slot-Row]=(((R[11:Tst-SlotInRack]-1) MOD 7)+1) ;
  67:  JMP LBL[200] ;
  68:   ;
  69:  !***Rack-5 (Full)**************** ;
  70:  LBL[150] ;
  71:  !Set Column/Row Num of Slot ;
  72:  R[25:*Slot-Colmn]=(((R[11:Tst-SlotInRack]-1) DIV 7)+1) ;
  73:  R[26:*Slot-Row]=(((R[11:Tst-SlotInRack]-1) MOD 7)+1) ;
  74:  JMP LBL[200] ;
  75:   ;
  76:  !***Rack-6 (Full)**************** ;
  77:  LBL[160] ;
  78:  !**Adjust for Unpickable Slots ;
  79:  IF (R[11:Tst-SlotInRack]=6 OR R[11:Tst-SlotInRack]=7),R[11:Tst-SlotInRack]=(8) ;
  80:  IF (R[11:Tst-SlotInRack]=13 OR R[11:Tst-SlotInRack]=14),R[11:Tst-SlotInRack]=(15) ;
  81:  !Set Column/Row Num of Slot ;
  82:  R[25:*Slot-Colmn]=(((R[11:Tst-SlotInRack]-1) DIV 7)+1) ;
  83:  R[26:*Slot-Row]=(((R[11:Tst-SlotInRack]-1) MOD 7)+1) ;
  84:  JMP LBL[200] ;
  85:   ;
  86:   ;
  87:  !*********Chk Pick Pos*********** ;
  88:  LBL[200] ;
  89:  F[21:OFF:Rack Slot-Set]=(OFF) ;
  90:  CALL _SET_RACK_SLOT    ;
  91:  IF (F[21:OFF:Rack Slot-Set]),JMP LBL[300] ;
  92:  JMP LBL[700] ;
  93:   ;
  94:   ;
  95:  !***Chk Slot Status Reg********** ;
  96:  LBL[300] ;
  97:  R[199:*RackSts-Reg]=R[21:*SlotNum]+200    ;
  98:  !Slot Status Should be > 0 ;
  99:  //IF (R[R[199]]<=0),JMP LBL[700] ;
 100:  JMP LBL[400] ;
 101:   ;
 102:   ;
 103:  !*******Set Slot X/Z Offs******** ;
 104:  LBL[400] ;
 105:  R[22:*X-Offs]=((R[25:*Slot-Colmn]-1)*R[381:Rack-Colmn Offs]) ;
 106:  R[23:*Z-Offs]=((R[26:*Slot-Row]-1)*R[382:Rack-Row Offs]) ;
 107:   ;
 108:  !***Set Slot PR*** ;
 109:  PR[20:*Rack PKPL]=PR[R[27]]    ;
 110:  //PR[20,1:*Rack PKPL]=PR[R[27],1]+R[22:*X-Offs]    ;
 111:  PR[20,3:*Rack PKPL]=PR[R[27],3]+R[23:*Z-Offs]    ;
 112:   ;
 113:  !***Set Appr PR*** ;
 114:  PR[21:*Rack Appr]=PR[R[28]]    ;
 115:  JMP LBL[500] ;
 116:   ;
 117:   ;
 118:  !***********FUTURE USE*********** ;
 119:  LBL[500] ;
 120:  JMP LBL[900] ;
 121:   ;
 122:   ;
 123:  !***RACK PK NOT RDY************** ;
 124:  LBL[700] ;
 125:  F[20:OFF:Rack PKPL-Set]=(OFF) ;
 126:  F[21:OFF:Rack Slot-Set]=(OFF) ;
 127:  JMP LBL[999] ;
 128:   ;
 129:  !***RACK PK RDY****************** ;
 130:  LBL[900] ;
 131:  F[20:OFF:Rack PKPL-Set]=(ON) ;
 132:  F[21:OFF:Rack Slot-Set]=(OFF) ;
 133:  JMP LBL[999] ;
 134:   ;
 135:   ;
 136:  LBL[999] ;
/POS
/END
