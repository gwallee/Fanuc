/PROG  _INSPECT_PRE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Pre-Dump Inspect";
PROG_SIZE	= 2547;
CREATE		= DATE 26-07-13  TIME 10:14:36;
MODIFIED	= DATE 26-08-24  TIME 15:42:12;
FILE_NAME	= _SCAN_TO;
VERSION		= 0;
LINE_COUNT	= 125;
MEMORY_SIZE	= 2975;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : FALSE;
/MN
   1:  !*****INSPECT TOTE PRE-DUMP****** ;
   2:  LBL[100] ;
   3:  IF (!F[1:ON :Part in Grip]),JMP LBL[999] ;
   4:  R[44:*CamDnTries]=0    ;
   5:  R[45:*Pre/Post Inspct]=1    ;
   6:   ;
   7:  !***Setup Inspect Chk************ ;
   8:  LBL[110] ;
   9:  F[45:OFF:PreInspect-Set]=(OFF) ;
  10:  CALL _SET_INSPECT(1) ;
  11:  IF (F[45:OFF:PreInspect-Set]),JMP LBL[150] ;
  12:  JMP LBL[999] ;
  13:   ;
  14:  !***Appr Cam (Hopper Appr)******* ;
  15:  LBL[150] ;
  16:  IF (DO[205:OFF:At Hopper Appr]),JMP LBL[200] ;
  17:  IF (DO[204:OFF:At Inspct Pos]),JMP LBL[250] ;
  18:  CALL _APPR_HOPPER(1) ;
  19:  IF (F[700:OFF:Appr Error]),JMP LBL[700] ;
  20:  JMP LBL[150] ;
  21:   ;
  22:   ;
  23:  !***Move to Inspect Pos********** ;
  24:  LBL[200] ;
  25:  UFRAME_NUM=0 ;
  26:  UTOOL_NUM=1 ;
  27:J PR[41:Hopper Appr] R[104:ToteSpd-J]% CNT50    ;
  28:   ;
  29:  CALL _SET_OFFS((-800),0,(-8),61) ;
  30:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT50 Tool_Offset    ;
  31:  CALL _SET_OFFS((-600),0,(-8),61) ;
  32:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT100 Tool_Offset    ;
  33:  CALL _SET_OFFS(0,0,(-8),61) ;
  34:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT25 Tool_Offset    ;
  35:  JMP LBL[250] ;
  36:   ;
  37:  !**Final Move to Inspect Pos ;
  38:  LBL[250] ;
  39:  UFRAME_NUM=0 ;
  40:  UTOOL_NUM=1 ;
  41:L PR[45:Inspect Pos] R[103:ToteSpd-L]mm/sec FINE    ;
  42:  WAIT (DO[204:OFF:At Inspct Pos])    ;
  43:  R[44:*CamDnTries]=0    ;
  44:  JMP LBL[300] ;
  45:   ;
  46:   ;
  47:  !***First Image****************** ;
  48:  LBL[300] ;
  49:  DO[30:OFF:Inspect Trigger]=OFF ;
  50:  DO[31:OFF:Inspect Ack]=OFF ;
  51:  WAIT    .25(sec) ;
  52:  WAIT (!DI[30:OFF:Inspect Pass] AND !DI[31:OFF:Inspect Fail])    ;
  53:   ;
  54:  !**Trigger Inspect ;
  55:  CALL _SET_WAIT(R[47:*WaitTm x100]) ;
  56:  DO[30:OFF:Inspect Trigger]=ON ;
  57:  !Wait for Pass/Fail ;
  58:  WAIT (DI[30:OFF:Inspect Pass] OR DI[31:OFF:Inspect Fail]) TIMEOUT,LBL[307] ;
  59:  !**Inspect Done, Chk Pass/Fail ;
  60:  IF (DI[30:OFF:Inspect Pass]),JMP LBL[310] ;
  61:  IF (DI[31:OFF:Inspect Fail]),JMP LBL[320] ;
  62:  JMP LBL[307] ;
  63:   ;
  64:  !**Inspect Not Done ;
  65:  LBL[307] ;
  66:  R[44:*CamDnTries]=R[44:*CamDnTries]+1    ;
  67:  IF (R[44:*CamDnTries]<2),JMP LBL[300] ;
  68:  !Too Many Done Tries ;
  69:  DO[30:OFF:Inspect Trigger]=OFF ;
  70:  DO[31:OFF:Inspect Ack]=OFF ;
  71:  DO[57:OFF:Inspect Err]=ON ;
  72:  PAUSE ;
  73:  DO[57:OFF:Inspect Err]=OFF ;
  74:  JMP LBL[100] ;
  75:   ;
  76:  !***Inspect Passed*** ;
  77:  LBL[310] ;
  78:  R[100:*Tote-Sts ID]=30    ;
  79:  JMP LBL[500] ;
  80:   ;
  81:  !***Inspect Failed*** ;
  82:  LBL[320] ;
  83:  !TEMP-dont retry, just reject ;
  84:  R[100:*Tote-Sts ID]=71    ;
  85:  JMP LBL[500] ;
  86:   ;
  87:   ;
  88:  !***Inspect Complete************* ;
  89:  LBL[500] ;
  90:  DO[30:OFF:Inspect Trigger]=OFF ;
  91:  !**Inspect Ack hs ;
  92:  DO[31:OFF:Inspect Ack]=ON ;
  93:  WAIT    .25(sec) ;
  94:  WAIT (!DI[30:OFF:Inspect Pass] AND !DI[31:OFF:Inspect Fail])    ;
  95:  DO[31:OFF:Inspect Ack]=OFF ;
  96:   ;
  97:  !Jump for Next Task ;
  98:  LBL[505] ;
  99:  IF R[100:*Tote-Sts ID]=30,JMP LBL[600] ;
 100:  JMP LBL[510] ;
 101:   ;
 102:  !***Go to Transit*** ;
 103:  LBL[560] ;
 104:  CALL _SET_OFFS(0,0,(-8),61) ;
 105:L PR[43:Orig-Hopper-Nrml] R[107:Rtrt Spd]mm/sec CNT50 Tool_Offset    ;
 106:  CALL _SET_OFFS((-600),0,(-8),61) ;
 107:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT100 Tool_Offset    ;
 108:  CALL _SET_OFFS((-800),0,(-8),61) ;
 109:L PR[43:Orig-Hopper-Nrml] R[103:ToteSpd-L]mm/sec CNT50 Tool_Offset    ;
 110:L PR[41:Hopper Appr] R[103:ToteSpd-L]mm/sec CNT100    ;
 111:   ;
 112:  CALL _TRANSIT(0) ;
 113:  WAIT (DO[37:OFF:At Transit])    ;
 114:  JMP LBL[600] ;
 115:   ;
 116:   ;
 117:  !***Inspect Done***************** ;
 118:  LBL[600] ;
 119:  F[45:OFF:PreInspect-Set]=(OFF) ;
 120:  R[44:*CamDnTries]=0    ;
 121:  R[45:*Pre/Post Inspct]=0    ;
 122:  JMP LBL[999] ;
 123:   ;
 124:   ;
 125:  LBL[999] ;
/POS
/END
