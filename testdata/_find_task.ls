/PROG  _FIND_TASK
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Find Next Task";
PROG_SIZE	= 5211;
CREATE		= DATE 22-11-04  TIME 14:42:20;
MODIFIED	= DATE 26-08-25  TIME 12:05:20;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 259;
MEMORY_SIZE	= 5967;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : FALSE;
/MN
   1:  !*****FIND A TASK TO EXECUTE***** ;
   2:  F[8:OFF:Task Rdy]=(OFF) ;
   3:  R[8:Task-JMP LBL]=0    ;
   4:  !Chk-SysChks, Auto=OFF, Start=OFF ;
   5:  IF (F[101:OFF:Sys Chks]),JMP LBL[999] ;
   6:  IF (!DI[1:ON :Auto Mode]),JMP LBL[999] ;
   7:  IF (!DI[2:OFF:Start]),JMP LBL[999] ;
   8:   ;
   9:  !Jump for Gripper Status ;
  10:  LBL[100] ;
  11:  IF (F[1:ON :Part in Grip]),JMP LBL[200] ;
  12:  JMP LBL[101] ;
  13:   ;
  14:   ;
  15:  !******************************** ;
  16:  !**********Grip-No Tote********** ;
  17:  LBL[101] ;
  18:  !**Chk Grip Tote ID/Sts = 0 ;
  19:  IF (R[5:*Grp-ToteID]<>0),JMP LBL[701] ;
  20:  IF (R[100:*Tote-Sts ID]<>0),JMP LBL[702] ;
  21:   ;
  22:  !***Chk which Tasks Pk Rdy*** ;
  23:  LBL[105] ;
  24:  IF ((DI[17:OFF:Infd Pk Rdy] OR DI[18:OFF:Recon Pk Rdy]) AND DI[21:OFF:RackPK Rdy]),JMP LBL[130] ;
  25:  IF ((DI[17:OFF:Infd Pk Rdy] OR DI[18:OFF:Recon Pk Rdy]) AND !DI[21:OFF:RackPK Rdy]),JMP LBL[110] ;
  26:  IF ((!DI[17:OFF:Infd Pk Rdy] AND !DI[18:OFF:Recon Pk Rdy]) AND DI[21:OFF:RackPK Rdy]),JMP LBL[120] ;
  27:  JMP LBL[800] ;
  28:   ;
  29:  !**Only Conv Pk Rdy ;
  30:  LBL[110] ;
  31:  JMP LBL[920] ;
  32:   ;
  33:  !**Only Rack Pk Rdy ;
  34:  LBL[120] ;
  35:  JMP LBL[921] ;
  36:   ;
  37:  !**Conv/Rack Pk Rdy: Chk PrevPk ;
  38:  !1=Picked Conv, 2=Picked Rack ;
  39:  LBL[130] ;
  40:  IF R[13:*PrvPk-Conv/Rack]=1,JMP LBL[921] ;
  41:  JMP LBL[920] ;
  42:  !******************************** ;
  43:   ;
  44:   ;
  45:  !******************************** ;
  46:  !**********Part on Grip********** ;
  47:  LBL[200] ;
  48:  IF (F[7:OFF:Mult Tasks Rdy]),JMP LBL[703] ;
  49:   ;
  50:  !Chk Tote ID ;
  51:  IF ((R[5:*Grp-ToteID]>=1 AND R[5:*Grp-ToteID]<=168) OR R[5:*Grp-ToteID]=200 OR R[5:*Grp-ToteID]=201),JMP LBL[205] ;
  52:  JMP LBL[701] ;
  53:   ;
  54:  !Jump for Grip Tote Sts ;
  55:  LBL[205] ;
  56:  SELECT R[100:*Tote-Sts ID]=10,JMP LBL[210] ;
  57:         =11,JMP LBL[220] ;
  58:         =20,JMP LBL[230] ;
  59:         =25,JMP LBL[230] ;
  60:         =30,JMP LBL[240] ;
  61:         =35,JMP LBL[240] ;
  62:         =40,JMP LBL[250] ;
  63:         =50,JMP LBL[260] ;
  64:         =55,JMP LBL[260] ;
  65:         =60,JMP LBL[960] ;
  66:         =70,JMP LBL[960] ;
  67:         =71,JMP LBL[960] ;
  68:         =72,JMP LBL[960] ;
  69:  JMP LBL[702] ;
  70:   ;
  71:  !***Picked from Conv*** ;
  72:  !Next: Scan BC or Skip ;
  73:  LBL[210] ;
  74:  IF (DI[28:OFF:Reject PL Cmd] AND R[385:Skip Scan-RjctPL]<>0),JMP LBL[212] ;
  75:  IF (R[383:Skip Scan-ConvPk]<>0),JMP LBL[211] ;
  76:  !**Scan Rdy ;
  77:  JMP LBL[922] ;
  78:  !**Skip Scan ;
  79:  LBL[211] ;
  80:  R[100:*Tote-Sts ID]=25    ;
  81:  JMP LBL[800] ;
  82:  !**Reject-Skip Scan ;
  83:  LBL[212] ;
  84:  R[100:*Tote-Sts ID]=60    ;
  85:  JMP LBL[800] ;
  86:   ;
  87:  !***Picked from Rack*** ;
  88:  !Next: Scan BC or Skip ;
  89:  LBL[220] ;
  90:  IF (DI[28:OFF:Reject PL Cmd] AND R[385:Skip Scan-RjctPL]<>0),JMP LBL[222] ;
  91:  IF (R[384:Skip Scan-RackPk]<>0),JMP LBL[221] ;
  92:  !**Scan Rdy ;
  93:  JMP LBL[922] ;
  94:  !**Skip Scan ;
  95:  LBL[221] ;
  96:  R[100:*Tote-Sts ID]=25    ;
  97:  JMP LBL[800] ;
  98:  !**Reject-Skip Scan ;
  99:  LBL[222] ;
 100:  R[100:*Tote-Sts ID]=60    ;
 101:  JMP LBL[800] ;
 102:   ;
 103:  !***BC Scanned or Skipped*** ;
 104:  LBL[230] ;
 105:  !Find Next Task ;
 106:  IF (DI[28:OFF:Reject PL Cmd]),JMP LBL[232] ;
 107:  IF (DI[19:OFF:Outfd PL Rdy] OR DI[20:OFF:Recon PL Rdy]),JMP LBL[236] ;
 108:  IF (DI[22:OFF:RackPL Rdy]),JMP LBL[237] ;
 109:  IF (DI[22:OFF:RackPL Rdy]),JMP LBL[237] ;
 110:  IF (!DI[23:OFF:Hopper Rdy]),JMP LBL[800] ;
 111:  !Chk for Skip ;
 112:  IF (F[2:OFF:ToteOrig-Convs] AND R[386:Skip Pre-ConvPk]<>0),JMP LBL[231] ;
 113:  IF (F[3:OFF:ToteOrig-Racks] AND R[387:Skip Pre-RackPk]<>0),JMP LBL[231] ;
 114:  !**Inspect Rdy ;
 115:  JMP LBL[923] ;
 116:  !**Skip Inspect ;
 117:  LBL[231] ;
 118:  R[100:*Tote-Sts ID]=35    ;
 119:  JMP LBL[800] ;
 120:  !**Reject-Skip Inspect ;
 121:  LBL[232] ;
 122:  R[100:*Tote-Sts ID]=60    ;
 123:  JMP LBL[800] ;
 124:  !**No Hopper-PL on Conv ;
 125:  LBL[236] ;
 126:  R[100:*Tote-Sts ID]=55    ;
 127:  JMP LBL[800] ;
 128:  !**No Hopper-PL on Rack ;
 129:  LBL[237] ;
 130:  R[100:*Tote-Sts ID]=55    ;
 131:  JMP LBL[800] ;
 132:   ;
 133:  !***Pre-Insp Pass or Skipped*** ;
 134:  LBL[240] ;
 135:  !Chk Hopper = Next Task ;
 136:  IF (DI[28:OFF:Reject PL Cmd]),JMP LBL[242] ;
 137:  IF (DI[19:OFF:Outfd PL Rdy] OR DI[20:OFF:Recon PL Rdy]),JMP LBL[246] ;
 138:  IF (DI[22:OFF:RackPL Rdy]),JMP LBL[247] ;
 139:  IF (DI[22:OFF:RackPL Rdy]),JMP LBL[247] ;
 140:  IF (!DI[23:OFF:Hopper Rdy]),JMP LBL[800] ;
 141:  !**Hopper Rdy ;
 142:  JMP LBL[924] ;
 143:  !**Reject-No Hopper ;
 144:  LBL[242] ;
 145:  R[100:*Tote-Sts ID]=60    ;
 146:  JMP LBL[800] ;
 147:  !**No Hopper-PL on Conv ;
 148:  LBL[246] ;
 149:  R[100:*Tote-Sts ID]=55    ;
 150:  JMP LBL[800] ;
 151:  !**No Hopper-PL on Rack ;
 152:  LBL[247] ;
 153:  R[100:*Tote-Sts ID]=55    ;
 154:  JMP LBL[800] ;
 155:   ;
 156:  !***Hopper Fill Done*** ;
 157:  LBL[250] ;
 158:  //IF (DI[28:OFF:Reject PL Cmd]),JMP LBL[960] ;
 159:  //IF (!DI[19:OFF:Outfd PL Rdy] AND !DI[20:OFF:Recon PL Rdy] AND !DI[22:OFF:RackPL Rdy] AND !DI[28:OFF:Reject PL Cmd]),JMP LBL[800] ;
 160:  //!Chk for Skip ;
 161:  //IF ((DI[19:OFF:Outfd PL Rdy] OR DI[20:OFF:Recon PL Rdy]) AND R[388:Skip Post-ConvPL]<>0),JMP LBL[251] ;
 162:  //IF (DI[22:OFF:RackPL Rdy] AND R[389:Skip Post-RackPL]<>0),JMP LBL[251] ;
 163:  !**Inspect Rdy ;
 164:  JMP LBL[925] ;
 165:  !**Skip Inspect ;
 166:  LBL[251] ;
 167:  R[100:*Tote-Sts ID]=55    ;
 168:  JMP LBL[800] ;
 169:   ;
 170:  !***Post-Insp Done or Skipped*** ;
 171:  LBL[260] ;
 172:  !Find Next Task ;
 173:  IF ((DI[19:OFF:Outfd PL Rdy] OR DI[20:OFF:Recon PL Rdy])),JMP LBL[926] ;
 174:  IF (DI[22:OFF:RackPL Rdy]),JMP LBL[927] ;
 175:  IF (DI[23:OFF:Hopper Rdy]),JMP LBL[924] ;
 176:  IF (DI[28:OFF:Reject PL Cmd]),JMP LBL[960] ;
 177:  !**No PL Cmd ;
 178:  JMP LBL[800] ;
 179:  !******************************** ;
 180:   ;
 181:   ;
 182:  !*************ERRORS************* ;
 183:  !***Err: EOAT Unknown Tote ID ;
 184:  LBL[701] ;
 185:  DO[51:OFF:Unknown ToteID]=ON ;
 186:  PAUSE ;
 187:  DO[51:OFF:Unknown ToteID]=OFF ;
 188:  JMP LBL[100] ;
 189:   ;
 190:  !***Err: EOAT Unknown Tote Sts ;
 191:  LBL[702] ;
 192:  DO[52:OFF:Unknown ToteSts]=ON ;
 193:  PAUSE ;
 194:  DO[52:OFF:Unknown ToteSts]=OFF ;
 195:  JMP LBL[100] ;
 196:   ;
 197:  !***Err: Multiple Tote Tasks ON ;
 198:  LBL[703] ;
 199:  DO[53:OFF:Tote Task Err]=ON ;
 200:  PAUSE ;
 201:  DO[53:OFF:Tote Task Err]=OFF ;
 202:  JMP LBL[100] ;
 203:  !******************************** ;
 204:   ;
 205:   ;
 206:  !*********NO TASK FOUND********** ;
 207:  LBL[800] ;
 208:  F[8:OFF:Task Rdy]=(OFF) ;
 209:  R[8:Task-JMP LBL]=0    ;
 210:  JMP LBL[999] ;
 211:   ;
 212:   ;
 213:  !***********TASK FOUND*********** ;
 214:  LBL[920:Pick Conv] ;
 215:  R[8:Task-JMP LBL]=200    ;
 216:  JMP LBL[990] ;
 217:   ;
 218:  LBL[921:Pick Rack] ;
 219:  R[8:Task-JMP LBL]=210    ;
 220:  JMP LBL[990] ;
 221:   ;
 222:  LBL[922:Scan BC] ;
 223:  R[8:Task-JMP LBL]=220    ;
 224:  JMP LBL[990] ;
 225:   ;
 226:  LBL[923:Pre-Inspect] ;
 227:  R[8:Task-JMP LBL]=230    ;
 228:  JMP LBL[990] ;
 229:   ;
 230:  LBL[924:Hopper Fill] ;
 231:  R[8:Task-JMP LBL]=240    ;
 232:  JMP LBL[990] ;
 233:   ;
 234:  LBL[925:Post-Inspect] ;
 235:  R[8:Task-JMP LBL]=250    ;
 236:  JMP LBL[990] ;
 237:   ;
 238:  LBL[926:Place Conv] ;
 239:  R[8:Task-JMP LBL]=260    ;
 240:  JMP LBL[990] ;
 241:   ;
 242:  LBL[927:Place Rack] ;
 243:  R[8:Task-JMP LBL]=270    ;
 244:  JMP LBL[990] ;
 245:   ;
 246:   ;
 247:  !***MISCELLANEOUS-Set Task******* ;
 248:  LBL[960:PL Reject] ;
 249:  R[8:Task-JMP LBL]=600    ;
 250:  JMP LBL[990] ;
 251:   ;
 252:   ;
 253:  !************TASK SET************ ;
 254:  LBL[990] ;
 255:  F[8:OFF:Task Rdy]=(ON) ;
 256:  JMP LBL[999] ;
 257:   ;
 258:   ;
 259:  LBL[999] ;
/POS
/END
